#!/bin/sh
#
# Empêche un `git push` si les vérifications rapides échouent — l'équivalent
# local d'une protection de branche (indisponible sur dépôt privé gratuit).
# La CI GitHub rejoue tout, build complet inclus ; ici on attrape l'essentiel
# avant que ça quitte la machine.
#
# Activation (une fois par clone) :  git config core.hooksPath .githooks
# Échappatoire d'urgence           :  git push --no-verify
#
set -e

root=$(git rev-parse --show-toplevel)
echo "── pre-push : vérifications avant envoi ──"

echo "▶ format — Prettier"
( cd "$root" && npx prettier --check . >/dev/null ) || { echo "✗ fichiers non formatés : lancer npm run format à la racine"; exit 1; }

# Le back et le front lisent le paquet partagé compilé (dist/) : il passe en premier.
echo "▶ paquet partagé — types + tests + build"
( cd "$root/packages/domain" && npm run typecheck && npm test && npm run build )

echo "▶ backend — build + tests, description OpenAPI à jour"
( cd "$root/backend" && npm run build && npm test && npm run -s openapi >/dev/null 2>&1 && git diff --quiet -- openapi.json ) ||
  { echo "✗ backend en échec, ou backend/openapi.json à régénérer : npm run openapi (backend), puis npm run api:types (frontend)"; exit 1; }

echo "▶ frontend — types de l'API à jour, lint + types + tests"
( cd "$root/frontend" && npm run -s api:types >/dev/null 2>&1 && git diff --quiet -- lib/api/schema.d.ts ) ||
  { echo "✗ frontend/lib/api/schema.d.ts à régénérer : npm run api:types (frontend)"; exit 1; }
( cd "$root/frontend" && npm run lint && npm run typecheck && npm test )

echo "✓ tout est vert — push autorisé"
