# Copier en deploy/.env (jamais versionné) et remplir. Une copie par
# environnement : production et pré-production.

# Domaine public (enregistrement DNS A vers l'IP du serveur). Ex. hub.greyconcrete.sn
HUB_DOMAINE=

# Base PostgreSQL (dans le conteneur, jamais exposée sur internet)
POSTGRES_USER=hub
POSTGRES_PASSWORD=          # openssl rand -base64 32
POSTGRES_DB=hub

# Secret de signature des sessions — au moins 32 caractères aléatoires
JWT_SECRET=                 # openssl rand -base64 48
JWT_EXPIRES_IN=7d
# Double authentification de la direction, des comptes techniques et des
# chefs de cellule : obligatoire en production. « desactive » ne la suspend
# que sur un serveur de démonstration (HUB_DONNEES_DEMO=autorise), jamais sur
# un HUB réel ; changer JWT_SECRET oblige chacun à réactiver son application.
HUB_DOUBLE_FACTEUR=

# E-mails (Brevo, SMTP) — "log" tant que les identifiants ne sont pas posés
EMAIL_TRANSPORT=log
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=hub360° <no-reply@VOTRE-DOMAINE>
MAIL_MARQUE=hub360°
# Alertes du suivi des erreurs et des sauvegardes (vide : journaux seulement)
ALERTES_EMAIL=

# Stockage objet Hetzner (compatible S3) — fichiers et sauvegardes
S3_ENDPOINT=                # ex. https://fsn1.your-objectstorage.com
S3_REGION=eu-central
S3_BUCKET=                  # fichiers du HUB
S3_BUCKET_SAUVEGARDES=      # sauvegardes de la base (bucket séparé)
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Pré-production uniquement : autorise les données de démo (jamais en prod)
HUB_DONNEES_DEMO=
