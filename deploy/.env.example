# Copier en deploy/.env (jamais versionné) et remplir. Une copie par
# environnement : production et pré-production.

# Domaine public (enregistrement DNS A vers l'IP du serveur). Ex. hub.greyconcrete.sn
HUB_DOMAINE=

# Base PostgreSQL (dans le conteneur, jamais exposée sur internet)
POSTGRES_USER=hub
POSTGRES_PASSWORD=          # openssl rand -base64 32
POSTGRES_DB=hub

# Secret de signature des sessions — au moins 32 caractères aléatoires
JWT_SECRET=                 # openssl rand -base64 48
JWT_EXPIRES_IN=7d
# Double authentification de tous les comptes : obligatoire en production.
# « desactive » ne la suspend que sur un serveur de démonstration
# (HUB_DONNEES_DEMO=autorise), jamais sur un HUB réel ; changer JWT_SECRET
# oblige chacun à réactiver son application.
HUB_DOUBLE_FACTEUR=

# E-mails (Brevo, SMTP) — "log" tant que les identifiants ne sont pas posés
EMAIL_TRANSPORT=log
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=hub360° <no-reply@VOTRE-DOMAINE>
MAIL_MARQUE=hub360°
# Alertes du suivi des erreurs et des sauvegardes (vide : journaux seulement)
ALERTES_EMAIL=

# Stockage objet des fichiers (compatible S3) — réservé : non utilisé
# aujourd'hui, les fichiers sont enregistrés dans la base (donc sauvegardés
# avec elle). Laisser vide.
S3_ENDPOINT=
S3_REGION=eu-central
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Sauvegardes (docs/mise-en-production.md, étape « Sauvegardes ») —
# conservation 7 quotidiennes, 4 hebdomadaires, 12 mensuelles.
# Storage Box Hetzner : hôte et identifiant (ex. u123456.your-storagebox.de,
# u123456) ; clé SSH et empreinte du serveur dans deploy/secrets/.
SAUVEGARDE_BOITE_HOTE=
SAUVEGARDE_BOITE_UTILISATEUR=
# Seconde copie chiffrée chez un autre fournisseur (compatible S3).
SAUVEGARDE_DISTANT_FOURNISSEUR=Other   # type rclone : Scaleway, Backblaze… ou Other
SAUVEGARDE_DISTANT_ENDPOINT=           # ex. https://s3.fr-par.scw.cloud
SAUVEGARDE_DISTANT_REGION=
SAUVEGARDE_DISTANT_BUCKET=
SAUVEGARDE_DISTANT_ACCESS_KEY=
SAUVEGARDE_DISTANT_SECRET_KEY=
# Clé PUBLIQUE age (age1…) : la clé privée reste hors du serveur.
SAUVEGARDE_CLE_PUBLIQUE=

# Pré-production uniquement : autorise les données de démo (jamais en prod)
HUB_DONNEES_DEMO=
