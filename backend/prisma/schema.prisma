// Schéma de base de données HUB
// Pensé pour qu'une nouvelle société s'ajoute sans toucher au code :
// tout passe par des lignes en base (societes, societe_modules, roles).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Societe {
  id                           String   @id @default(uuid())
  nom                          String
  slug                         String   @unique
  logoUrl                      String?  @map("logo_url")
  // Variante du logo pensée pour un fond sombre (le portail est en anthracite) —
  // certains logos fournis (texte foncé sur transparent) sont illisibles sur fond
  // sombre tels quels ; celle-ci reste optionnelle, on retombe sur logoUrl sinon.
  logoUrlSombre                String?  @map("logo_url_sombre")
  couleurMarque                String?  @map("couleur_marque")
  // Clé d'icône générique (ex: "code", "building-2", "network") affichée sur
  // la tuile du portail — validée côté frontend contre une liste blanche
  // d'icônes disponibles, pas de logique par société codée en dur.
  icone                        String?
  secteur                      String?
  // Pied des documents (devis, factures) — texte tel que fourni par la
  // société (Grey Concrete : catalogue JSON « mentions_legales_pied_de_page »
  // et pied des CGV 2026). null = rien d'affiché.
  mentionsLegales              String?  @map("mentions_legales")
  coordonnees                  String? // adresse · téléphone · email de facturation
  // Pénalités de retard (% par mois, CGV art. 13) — rappelées sur la facture.
  penaliteRetardMensuelle      Decimal? @map("penalite_retard_mensuelle") @db.Decimal(4, 2)
  // Contrats (étape G) — réglages société, modifiables par societe_admin ou
  // CIO (Paramètres → Contrats). Vides au départ : aucun texte juridique
  // n'est inventé ; tant que le modèle ou le signataire manque, la génération
  // refuse avec un message clair.
  contratModele                String?  @map("contrat_modele") // texte à {{champs}}
  // Signataire Grey Concrete jusqu'au seuil de contresignature (Réglages ·
  // Règles et délais, 50 M FCFA TTC) : l'Architecte DPLG…
  contratSignataireNom         String?  @map("contrat_signataire_nom")
  contratSignataireFonction    String?  @map("contrat_signataire_fonction")
  // …au-delà du seuil, seul le CEO contresigne (maquette Réglages du boss).
  contratSignataireCeoNom      String?  @map("contrat_signataire_ceo_nom")
  contratSignataireCeoFonction String?  @map("contrat_signataire_ceo_fonction")
  // Offre (HT, complète) à partir de laquelle le contrat est rédigé sur mesure
  // (téléversé) au lieu d'être généré depuis le modèle. null = toujours modèle.
  contratSeuilSurMesureHt      Decimal? @map("contrat_seuil_sur_mesure_ht") @db.Decimal(14, 0)
  actif                        Boolean  @default(true)
  // Société du groupe annoncée sur le portail avant d'être ouverte (carte
  // « Bientôt », non cliquable) : pas d'écran de connexion, absente des
  // listes de gestion (RH, comptes du groupe, rappels) tant que false.
  accesOuvert                  Boolean  @default(true) @map("acces_ouvert")
  createdAt                    DateTime @default(now()) @map("created_at")

  roles                 UtilisateurSocieteRole[]
  rolesDefinis          Role[]
  modules               SocieteModule[]
  clients               Client[]
  dossiers              DossierCrm[]
  projets               Projet[]
  cellules              Cellule[]
  compteursCellule      CompteurCellule[]
  reportings            ReportingMensuel[]
  decisions             DecisionRegistre[]
  collaborateurs        Collaborateur[]
  canaux                Canal[]
  factures              Facture[]
  devis                 Devis[]
  produitsServices      ProduitService[]
  contrats              Contrat[]
  annexesContratGabarit AnnexeContratGabarit[]
  verrousNumerotation   VerrouNumerotation[]

  dossiersPersonnel DossierPersonnel[]
  gabaritVersions   GabaritVersion[]
  reglages          ReglageSociete[]
  journalReglages   JournalReglage[]
  interventionsHub  InterventionHub[]
  modulesDesactives ModuleDesactive[]
  signalements      Signalement[]
  journalDroits     JournalDroit[]

  rendezVous        RendezVous[]
  abonnementsAgenda AbonnementAgenda[]

  annonces Annonce[]

  postesRecrutement PosteRecrutement[]
  appelsCandidature AppelCandidature[]

  @@map("societes")
}

model Utilisateur {
  id                    String    @id @default(uuid())
  email                 String    @unique
  // Nullable : un collaborateur invité n'a pas encore de mot de passe (compte
  // créé, actif=false, en attente d'activation via le lien d'invitation).
  motDePasseHash        String?   @map("mot_de_passe_hash")
  nom                   String
  prenom                String
  // Profil (menu du compte, 23/10/2026). Nom affiché : choisi par la
  // personne, montré là où l'on échange (salutation, avatar, messagerie,
  // fils, mentions) ; le nom officiel (nom/prenom, géré par la RH) reste
  // partout où il y a une trace de travail. Photo : image carrée allégée par
  // le navigateur, servie par /photos/:photoCle (clé non devinable, changée
  // à chaque nouvelle photo — le cache du navigateur suit).
  nomAffiche            String?   @map("nom_affiche")
  photo                 Bytes?
  photoType             String?   @map("photo_type")
  photoCle              String?   @unique @map("photo_cle")
  // Connexions (sécurité du compte) : la dernière et la précédente.
  derniereConnexionLe   DateTime? @map("derniere_connexion_le")
  connexionPrecedenteLe DateTime? @map("connexion_precedente_le")
  // Double authentification (application TOTP, RFC 6238) : secret chiffré
  // (AES-256-GCM), actif dès totpActifLe ; dernier pas accepté (anti-rejeu)
  // et codes de secours à usage unique (SHA-256).
  totpSecret            String?   @map("totp_secret")
  totpActifLe           DateTime? @map("totp_actif_le")
  totpDernierPas        Int?      @map("totp_dernier_pas")
  totpCodesSecours      String[]  @default([]) @map("totp_codes_secours")
  actif                 Boolean   @default(true)
  // Verrouillage (lot C, décision du 28/10/2026) : essais de connexion
  // infructueux depuis la dernière connexion réussie (mot de passe ou code),
  // fin du verrouillage en cours, et verrouillages déjà subis depuis la
  // dernière connexion réussie (la durée double à chaque récidive).
  echecsConnexion       Int       @default(0) @map("echecs_connexion")
  verrouilleJusquau     DateTime? @map("verrouille_jusquau")
  verrouillages         Int       @default(0)
  // Invalide toute session émise avant cette date (reset de mot de passe,
  // désactivation). Vérifié dans jwt.strategy contre le `iat` du token.
  sessionsValidesDepuis DateTime? @map("sessions_valides_depuis")
  desactiveLe           DateTime? @map("desactive_le")
  desactiveParId        String?   @map("desactive_par_id") // utilisateurId de l'admin (audit, pas de FK)
  createdAt             DateTime  @default(now()) @map("created_at")

  roles                    UtilisateurSocieteRole[]
  rolesSupprimes           Role[]                   @relation("RoleSupprPar")
  collaborations           Collaborateur[]
  dossierPersonnel         DossierPersonnel?
  blocsEtudeSupprimes      BlocEtude[]              @relation("BlocEtudeSupprPar")
  invitations              Invitation[]
  notifications            Notification[]
  evenementsCompte         EvenementCompte[]
  messages                 Message[]
  canauxDmP1               Canal[]                  @relation("CanalDmP1")
  membresCanal             MembreCanal[]
  reactionsMessage         ReactionMessage[]
  abonnementsPush          AbonnementPush[]
  // Préférences de notification (catégories, heures calmes) — @hub/domain.
  preferencesNotifications Json?                    @map("preferences_notifications")
  abonnementsAgenda        AbonnementAgenda[]
  canauxDmP2               Canal[]                  @relation("CanalDmP2")
  lecturesCanal            LectureCanal[]
  dossiersCrees            DossierCrm[]             @relation("DossierCreePar")
  dossiersApportes         DossierCrm[]             @relation("DossierApporteur")
  dossiersPossedes         DossierCrm[]             @relation("DossierProprietaire")
  dossiersArchives         DossierCrm[]             @relation("DossierArchivePar")
  tachesProjetValidees     TacheProjet[]            @relation("TacheProjetValideePar")
  evenementsTachesProjet   EvenementTacheProjet[]   @relation("EvenementTacheProjetPar")
  commentairesProjet       CommentaireProjet[]      @relation("CommentaireProjetAuteur")
  mentionsProjet           CommentaireProjet[]      @relation("CommentaireProjetMentionne")
  transitionsDossier       DossierCrmTransition[]   @relation("TransitionDossierPar")
  signalements             Signalement[]            @relation("SignalementAuteur")
  avisDroits               RightsNotice[]

  @@map("utilisateurs")
}

// Rémunération d'un compte — donnée RH sensible, saisie par l'admin du groupe
// (sept. 2026). Table À PART (pas une colonne de Utilisateur ou de
// UtilisateurSocieteRole) : aucune requête d'authentification, de rôle ou
// d'annuaire ne peut la ramener par accident ; seul le service des comptes
// du groupe la lit. Une ligne par personne (un employeur dans les faits) ;
// pas de ligne = salaire non renseigné (jamais de 0 improvisé).

enum InvitationType {
  invitation
  reset
}

// Un seul mécanisme pour l'invitation initiale et le reset de mot de passe.
// On stocke le SHA-256 du jeton, jamais le jeton en clair (rejeu impossible si
// la base fuit). Usage unique réel : `usedAt` vérifié avant toute action.
model Invitation {
  id            String         @id @default(uuid())
  tokenHash     String         @unique @map("token_hash")
  type          InvitationType
  email         String
  utilisateurId String?        @map("utilisateur_id")
  expiresAt     DateTime       @map("expires_at")
  usedAt        DateTime?      @map("used_at")
  createdAt     DateTime       @default(now()) @map("created_at")

  utilisateur Utilisateur? @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([email, type])
  @@map("invitations")
}

enum EvenementCompteType {
  invitation_envoyee
  compte_active
  mdp_reinitialise
  compte_desactive
  compte_reactive
  role_modifie // par l'admin du groupe (écran Comptes & rôles)
  salaire_modifie // idem — le montant n'est PAS recopié dans le journal
  double_facteur_active // par le titulaire, à la connexion
  double_facteur_reinitialise // par l'administration du HUB (téléphone perdu)
  connexion_secours // revue CIO : connexion d'un compte technique (secours), CEO et CIO prévenus
  deconnexion_partout // le titulaire coupe toutes ses sessions (menu du compte)
  compte_verrouille // lot C : trop d'essais de connexion infructueux
  compte_debloque // lot C : par l'administration du HUB, avant la fin du verrouillage
  role_endosse // Administrateur HUB : rôle endossé à la connexion ou depuis le menu du compte
  lien_reinitialisation_envoye // par l'administration du HUB : lien de nouveau mot de passe envoyé par e-mail
}

// -- Notifications collaborateur --
// Événements discrets poussés au moment où ils surviennent (assignation de
// projet, changement de phase), une ligne par destinataire — même motif que
// EvenementCompte (type fermé, parId en audit sans FK, titre pré-rendu par le
// service : « le back tient la grammaire », cf. versAvantProjet). Les alertes
// d'échéance d'avant-projet ne sont PAS stockées ici : dérivées à la lecture
// du flux (pas de scheduler dans le projet).
enum NotificationType {
  projet_assigne
  phase_changee
  checklist_assignee
  prolongation_demandee
  prolongation_decidee
  // Cycle CRM (tableau validé sept. 2026) — cf. src/crm/notifications-crm.ts
  dossier_cree // nouveau lead : au directeur qui le portera (Dir. GC, 09/11/2026)
  dossier_modifie // fiche figée modifiée : propriétaire, créateur (+ CFO en validation)
  dossier_soumis
  dossier_renvoye
  offre_envoyee // offre validée par la CFO et partie chez le client
  // Rappels quotidiens (RappelsService, 7 h) — jamais deux fois le même.
  rappel_offre // offre envoyée sans réponse à J+3 puis J+6
  rappel_facture // facture échue non soldée (puis chaque semaine)
  rappel_tache // tâche due demain, ou passée en retard
  avenant_ts // élément ajouté en TS : ligne ajoutée au devis d'avenant, à envoyer
  signalement_recu // « Signaler un problème » : nouveau retour à traiter (CIO)
  offre_acceptee
  offre_refusee
  contrat_signe
  dossier_perdu // revue COO : au créateur du lead, au propriétaire, à l'apporteur
  offre_expiree // revue COO : tournée des rappels, offre restée sans réponse
  // Remise / validation des tâches (RH lot 5c) — cf. src/rh/taches.service.ts
  tache_remise
  tache_validee
  tache_renvoyee
  facture_a_valider // facture directe d'un lead préparée, à valider par le CFO
  mention_projet // @mention dans un fil de discussion de projet (maquette « Projets »)
  // Notifications manquantes (phase 3, 14/10/2026)
  tache_assignee // une tâche de projet vous est assignée
  absence_a_decider // demande d'absence à trancher (N+1, puis RH)
  absence_decidee // votre demande d'absence a été tranchée
  remboursement_a_traiter // demande de remboursement reçue (RH)
  remboursement_traite // votre remboursement a été traité
  decision_assignee // décision du registre dont vous êtes responsable
  facture_emise
  facture_payee
  // Feuille de temps (revue Salarié 19/10/2026) : écart signalé par le salarié
  ecart_temps_signale // à la RH
  ecart_temps_traite // au salarié, avec la réponse de la RH
  // Mon espace · Mes documents (19/10/2026) : pastille de l'onglet
  rappel_demande // demande RH en attente (absence, remboursement, attestation) : relance
  bulletin_depose // la RH a déposé un bulletin de paie
  attestation_delivree // la RH a délivré l'attestation demandée
  // Historique des salaires (revue RH validée 20/10/2026) : la RH propose, le CFO valide
  salaire_a_valider // au CFO (au CEO pour le salaire du CFO)
  salaire_decide // à la RH qui a proposé
  // Contrôle interne (revue CFO 20/10/2026)
  avoir_emis // au CEO, pour chaque avoir
  avoir_a_valider // au CEO, avoir au-delà du seuil
  avoir_decide // au demandeur
  cloture_a_faire // au CFO : mois précédent pas encore clôturé
  // Suivi des reportings (revue CFO, lot 5)
  reporting_question // à l'émetteur : question du destinataire
  reporting_reponse // à l'auteur de la question
  coordonnees_paiement_modifiees // au CEO : banque, RIB, Wave ou Orange Money changés (lot 6)
  commission_a_payer // au CFO : commission d'apporteur devenue exigible (revue COO)
  commission_payee // au COO : commission réglée par le CFO
  coordonnees_apporteur_modifiees // au CFO et au CEO : coordonnées de paiement d'un apporteur changées
  // Revue Dir. GC (lot 4, 21/10/2026)
  reglage_gouvernance_modifie // au CEO : un seuil de gouvernance changé dans Réglages
  droits_modifies // au CEO : une case de la matrice des droits changée (revue CIO)
  connexion_secours // au CEO et au CIO : connexion d'un compte technique de secours
  delegation_ceo // au délégataire (et au CIO) : délégation du CEO accordée ou révoquée
  synthese_mensuelle // au CEO et au CFO : synthèse du mois générée à la clôture
  attente_ceo // au CEO : une décision l'attend depuis 24 h (offre, facture à contresigner) ou 3 jours ouvrés (le reste)
  demande_droit_a_valider // au CEO : modification des droits du rôle CIO à valider
  demande_droit_decidee // au demandeur : modification des droits du CIO acceptée ou refusée
  ts_a_valider // au CTO : TS au-delà du seuil, demandé par le Dir. GC
  ts_decide // au demandeur : TS accepté (ajouté) ou refusé par le CTO
  suppleance_designee // au suppléant désigné par un Dir. GC pour son absence
  // Reportings mensuels (revue Dir. GC, lot 3) : rappel et relances à
  // l'émetteur, retard signalé une fois au destinataire, dépôt au destinataire.
  reporting_a_deposer
  reporting_en_retard
  reporting_depose
  visa_a_apposer // au Dir. GC : tâche validée qui attend son visa DPLG
  arrivant_a_affecter // au Dir. GC : compte Salarié créé, cellule à choisir
  // Registre des décisions (revue CTO) : relance au responsable, retard à l'auteur.
  rappel_decision
  decision_proposee // au CEO : le CTO ou le COO lui soumet une décision
  decision_arbitree // au CTO : acceptée, modifiée ou refusée
  decision_en_retard
  own_rights_changed // aux titulaires d'un rôle : leurs droits viennent de changer (matrice, 31/10/2026)
  rdv_invitation // Agenda (01/11/2026) : vous êtes invité à une réunion
  rdv_annule // Agenda : une réunion où vous étiez invité est annulée
  annonce_importante // Annonces (01/11/2026) : une annonce importante à lire
  annonce_a_valider // Annonces : une annonce attend sa validation avant publication
  poste_a_approuver // Recrutement (01/11/2026) : ouverture d'un poste à approuver
  poste_decide // Recrutement : votre demande d'ouverture de poste a été tranchée
  embauche_decidee // Recrutement : un candidat embauché, dossier RH ouvert
  poste_ouvert // Recrutement : un poste vient d'ouvrir, candidats à trouver (RH)
  entretien_planifie // Recrutement : entretien fixé (au demandeur du poste)
  candidat_decide // Recrutement : candidat embauché ou refusé (au demandeur du poste)
  candidature_recue // Recrutement : candidature déposée par le lien externe (RH, demandeur du poste)
  mention_chat // Messagerie (01/11/2026) : on vous a mentionné (@) dans une conversation
  groupe_chat // Messagerie : vous avez été ajouté à un groupe de discussion
}

model Notification {
  id             String           @id @default(uuid())
  destinataireId String           @map("destinataire_id") // utilisateurId
  societeId      String           @map("societe_id") // cloisonnement + purge par société
  type           NotificationType
  projetId       String?          @map("projet_id") // contexte cliquable
  dossierCrmId   String?          @map("dossier_crm_id") // contexte cliquable (cycle CRM)
  factureId      String?          @map("facture_id") // contexte cliquable (facture à valider)
  canalId        String?          @map("canal_id") // contexte cliquable (conversation : mention, groupe)
  pousseeLe      DateTime?        @map("poussee_le") // notification système envoyée (Web Push)
  titre          String // texte pré-rendu par le service
  parId          String?          @map("par_id") // qui a déclenché (audit, pas de FK)
  luLe           DateTime?        @map("lu_le")
  createdAt      DateTime         @default(now()) @map("created_at")

  destinataire Utilisateur @relation(fields: [destinataireId], references: [id], onDelete: Cascade)
  projet       Projet?     @relation(fields: [projetId], references: [id], onDelete: SetNull)
  dossierCrm   DossierCrm? @relation(fields: [dossierCrmId], references: [id], onDelete: SetNull)
  facture      Facture?    @relation(fields: [factureId], references: [id], onDelete: SetNull)
  canal        Canal?      @relation(fields: [canalId], references: [id], onDelete: SetNull)

  @@index([destinataireId, luLe])
  @@index([pousseeLe, createdAt])
  @@map("notifications")
}

// « Signaler un problème » (aide de la barre du haut, mois de test puis
// usage courant) : le HUB joint la page, le rôle et l'appareil ; le CIO suit
// chaque retour jusqu'à sa correction (Réglages › Signalements).
enum StatutSignalement {
  a_traiter
  en_cours
  corrige
}

model Signalement {
  id          String            @id @default(uuid())
  societeId   String            @map("societe_id")
  auteurId    String?           @map("auteur_id")
  description String
  page        String // chemin de la page au moment du signalement
  role        String // rôle de l'auteur à ce moment
  appareil    String // « mobile » | « ordinateur »
  capture     String? // data URI facultative, comme les autres pièces (phase 2 : stockage objet)
  statut      StatutSignalement @default(a_traiter)
  creeLe      DateTime          @default(now()) @map("cree_le")
  traiteLe    DateTime?         @map("traite_le")
  traiteParId String?           @map("traite_par_id") // audit, pas de FK

  societe Societe      @relation(fields: [societeId], references: [id], onDelete: Cascade)
  auteur  Utilisateur? @relation("SignalementAuteur", fields: [auteurId], references: [id], onDelete: SetNull)

  @@index([societeId, statut])
  @@map("signalements")
}

// Changements de la matrice des droits (écran Rôles) : qui a changé quel
// niveau, quand — lu par le journal d'audit (CEO, CIO). Jamais modifié.
model JournalDroit {
  id           String            @id @default(uuid())
  societeId    String            @map("societe_id") // société de l'auteur au moment du changement
  roleNom      String            @map("role_nom")
  module       String // clé du module (avant le 31/10/2026), puis libellé de l'étape (« CRM › Dossiers »)
  // Ancienne matrice (jusqu'au 31/10/2026) : niveaux en échelle.
  avant        NiveauPermission? // null = aucune ligne avant
  apres        NiveauPermission?
  // Depuis le 31/10/2026 : droits en lettres (« LE », « » = aucun).
  droitsAvant  String?           @map("droits_avant")
  droitsApres  String?           @map("droits_apres")
  parId        String?           @map("par_id") // audit, pas de FK
  // Rôle CIO (revue CIO, 22/10/2026) : la modification demandée (parId) n'est
  // appliquée qu'une fois validée par le CEO (valideParId).
  valideParId  String?           @map("valide_par_id")
  createdAt    DateTime          @default(now()) @map("created_at")
  // Ordre réel de l'événement dans le journal d'audit, posé par la base
  // (séquence commune, migration 20261026090000_ordre_journal).
  ordreJournal BigInt?           @map("ordre_journal")

  societe Societe @relation(fields: [societeId], references: [id], onDelete: Cascade)

  @@index([societeId, createdAt])
  @@map("journal_droits")
}

// Délégation du CEO (revue CEO, 22/10/2026) : aucune par défaut ; le CEO
// désigne, pour une période, un délégataire (CTO ou CFO). Jamais délégués :
// les droits du CIO, les demandes du délégataire lui-même, le salaire du CFO.
model DelegationCeo {
  id              String    @id @default(uuid())
  societeId       String    @map("societe_id")
  delegataireId   String    @map("delegataire_id")
  roleDelegataire String    @map("role_delegataire")
  du              String // AAAA-MM-JJ
  au              String // AAAA-MM-JJ, inclus
  creeParId       String    @map("cree_par_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  revoqueLe       DateTime? @map("revoque_le")
  revoqueParId    String?   @map("revoque_par_id")

  @@index([societeId, au])
  @@map("delegations_ceo")
}

// Synthèse mensuelle du CEO (revue CEO, 22/10/2026) : assemblée par le HUB
// à la clôture du mois, à partir de ce qu'il sait déjà — aucun travail du
// CFO, qui peut y ajouter un commentaire. Instantané figé : une réouverture
// suivie d'une nouvelle clôture la régénère (le commentaire est gardé).
model SyntheseMensuelle {
  id               String    @id @default(uuid())
  societeId        String    @map("societe_id")
  mois             String // AAAA-MM
  contenu          Json // sections { titre, lignes: { libelle, valeur, ton? }[] }
  genereLe         DateTime  @map("genere_le")
  commentaire      String?
  commentaireParId String?   @map("commentaire_par_id")
  commentaireLe    DateTime? @map("commentaire_le")

  @@unique([societeId, mois])
  @@map("syntheses_mensuelles")
}

// Modification des droits du rôle CIO (revue CIO, 22/10/2026) : le CIO ne
// modifie pas son propre rôle ; la demande attend la validation du CEO, qui
// l'accepte (appliquée, tracée) ou la refuse (motif).
enum StatutDemandeDroit {
  en_attente
  acceptee
  refusee
}

model DemandeDroit {
  id           String             @id @default(uuid())
  societeId    String             @map("societe_id")
  roleId       String             @map("role_id")
  roleNom      String             @map("role_nom")
  module       String
  avant        NiveauPermission?
  apres        NiveauPermission
  demandeParId String?            @map("demande_par_id")
  statut       StatutDemandeDroit @default(en_attente)
  decideParId  String?            @map("decide_par_id")
  decideLe     DateTime?          @map("decide_le")
  motif        String?
  createdAt    DateTime           @default(now()) @map("created_at")

  @@index([societeId, statut])
  @@map("demandes_droit")
}

// Rappels quotidiens déjà envoyés : la clé (ex. « tache:<id>:veille:<finLe> »)
// garantit qu'un rappel ne part qu'une fois, même si la tournée est rejouée
// (redémarrage du serveur).
model RappelEnvoye {
  cle       String   @id
  createdAt DateTime @default(now()) @map("created_at")

  @@map("rappels_envoyes")
}

// Journal d'audit des événements sensibles sur un compte.
model EvenementCompte {
  id            String              @id @default(uuid())
  utilisateurId String              @map("utilisateur_id")
  type          EvenementCompteType
  parId         String?             @map("par_id") // qui a déclenché (audit, pas de FK)
  detail        String              @default("")
  createdAt     DateTime            @default(now()) @map("created_at")
  // Ordre réel de l'événement dans le journal d'audit, posé par la base
  // (séquence commune, migration 20261026090000_ordre_journal).
  ordreJournal  BigInt?             @map("ordre_journal")

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([utilisateurId])
  @@map("evenements_compte")
}

// Un rôle est soit un « socle » partagé par toute la holding (societeId
// null — ex: les 3 rôles historiques holding_admin/societe_admin/collaborateur,
// ou un futur rôle transverse type CEO), soit défini par une société pour son
// usage propre (societeId renseigné — ex: Grey Concrete crée "Dir. GC", "CFO"...).
// Attention à ne pas confondre avec UtilisateurSocieteRole.societeId : ce
// dernier scope une ATTRIBUTION (qui a ce rôle où), celui-ci scope la
// DÉFINITION du rôle (qui a le droit de le créer/modifier et dans quel
// catalogue il apparaît). Un rôle socle peut être attribué transversalement
// (UtilisateurSocieteRole.societeId = null) ou pour une société précise ; un
// rôle propre à une société n'a de sens qu'attribué dans cette société-là.
// Unicité du nom : garantie en base seulement à l'intérieur d'une société
// (@@unique ci-dessous) — Postgres ne déduplique pas les societeId NULL entre
// eux, donc l'unicité des noms de rôles socles est à vérifier côté service.
model Role {
  id            String    @id @default(uuid())
  societeId     String?   @map("societe_id")
  nom           String // ex: holding_admin, societe_admin, collaborateur, "Dir. GC"
  description   String?
  // Suppression douce (CIO, ou responsable de la société propriétaire du rôle).
  supprimeLe    DateTime? @map("supprime_le")
  supprimeParId String?   @map("supprime_par_id")
  createdAt     DateTime  @default(now()) @map("created_at")

  societe      Societe?                 @relation(fields: [societeId], references: [id], onDelete: Cascade)
  supprimePar  Utilisateur?             @relation("RoleSupprPar", fields: [supprimeParId], references: [id], onDelete: SetNull)
  utilisateurs UtilisateurSocieteRole[]
  droits       RoleRight[]

  @@unique([societeId, nom])
  @@index([societeId])
  @@map("roles")
}

// Table pivot : le coeur du système multi-société.
// Une ligne = "cet utilisateur a ce rôle dans cette société".
// societeId nullable = rôle transverse (ex: holding_admin sur tout le groupe).
model UtilisateurSocieteRole {
  id            String   @id @default(uuid())
  utilisateurId String   @map("utilisateur_id")
  societeId     String?  @map("societe_id")
  roleId        String   @map("role_id")
  createdAt     DateTime @default(now()) @map("created_at")

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  societe     Societe?    @relation(fields: [societeId], references: [id], onDelete: Cascade)
  role        Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([utilisateurId, societeId, roleId])
  @@map("utilisateur_societe_roles")
}

model Module {
  id          String  @id @default(uuid())
  nom         String
  cle         String  @unique // ex: "projets", "finances", "documents", "communication"
  description String?

  societes SocieteModule[]
  etapes   ModuleStep[]

  @@map("modules")
}

// Niveaux de l'ancienne matrice (en échelle, jusqu'au 31/10/2026) : ne sert
// plus qu'aux lignes historiques du journal des droits et des demandes.
enum NiveauPermission {
  aucun
  lecture
  ecriture
  validation
}

// Étape d'un module (matrice des droits, 31/10/2026) : chaque bouton du HUB
// dépend d'une seule étape et d'un seul des quatre droits. `cle` est ce que
// portent la session et les routes (« crm », puis « crm.dossiers »…).
// `libelles` : la phrase de chaque droit pour cette étape
// ({ lecture, ecriture, validation, suppression }) ; un droit absent est
// « sans objet » et n'est jamais accordé.
model ModuleStep {
  id       String @id @default(uuid())
  moduleId String @map("module_id")
  cle      String @unique
  nom      String
  ordre    Int    @default(0)
  libelles Json

  module Module      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  droits RoleRight[]

  @@index([moduleId])
  @@map("etapes_module")
}

// Ce qu'un rôle peut faire sur une étape : quatre droits indépendants
// (décision du 31/10/2026). Pas de ligne = aucun droit (refus par défaut).
model RoleRight {
  id          String  @id @default(uuid())
  roleId      String  @map("role_id")
  etapeId     String  @map("etape_id")
  lecture     Boolean @default(false)
  ecriture    Boolean @default(false)
  validation  Boolean @default(false)
  suppression Boolean @default(false)

  role  Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  etape ModuleStep @relation(fields: [etapeId], references: [id], onDelete: Cascade)

  @@unique([roleId, etapeId])
  @@map("droits_roles")
}

// Avis « Vos droits ont changé » : bandeau en haut de page de chaque
// titulaire du rôle, jusqu'à « J'ai compris » (31/10/2026).
model RightsNotice {
  id            String    @id @default(uuid())
  utilisateurId String    @map("utilisateur_id")
  message       String
  createdAt     DateTime  @default(now()) @map("created_at")
  comprisLe     DateTime? @map("compris_le")

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([utilisateurId, comprisLe])
  @@map("avis_droits")
}

// Quels modules sont activés pour quelle société — zéro déploiement pour changer ça.
model SocieteModule {
  id        String  @id @default(uuid())
  societeId String  @map("societe_id")
  moduleId  String  @map("module_id")
  actif     Boolean @default(true)

  societe Societe @relation(fields: [societeId], references: [id], onDelete: Cascade)
  module  Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([societeId, moduleId])
  @@map("societe_modules")
}

// =============================================================================
// Grey Concrete — CRM, projets, avant-projet, pré-bilan
//
// Migration additive : aucune donnée existante pour ces modèles. Les 7 choix
// de conception (Decimal(14,0), couts en Json, enums Prisma, snapshot sur
// Projet, nom DossierCrm, gardes réimplémentées, validePar = utilisateurId)
// sont figés — voir l'artifact « Backend Grey Concrete ».
// =============================================================================

// -- Vocabulaire métier (fermé) --

enum NatureDossier {
  mandat_client
  promotion_interne
}

// Catégorie = type de mission confiée à Grey Concrete (doc « Création de
// projet côté CRM » §3.3, oct. 2026), choisie librement, indépendante de la
// nature de la mission (NatureDossier : qui porte le risque).
enum Categorie {
  conception
  developpement
  amenagement
}

// Cycle commercial Grey Concrete (étape E, validé sept. 2026). Les passages
// autorisés et qui peut les faire vivent dans crm/cycle.ts — jamais un
// changement libre de statut. onboard et perdu sont définitifs.
enum StatutCrm {
  nouveau_projet
  en_validation // attend la DAF (CFO)
  offre_envoyee
  onboard // client acquis → projet d'exécution créé (transaction pivot)
  perdu // motif obligatoire (journal des transitions)
}

enum StatutProjet {
  a_assigner
  assigne
  en_cours
  livre
}

enum Phase {
  avant_projet
  permis
  etudes
  chantier
  livre
}

// Listes du doc « Création de projet côté CRM » §3.3–3.4 (oct. 2026).
enum TypeBien {
  villa
  immeuble_residentiel
  immeuble_mixte
  immeuble_bureaux
  local_commercial
  hotelier
  equipement
}

enum Standing {
  economique // aucune commodité
  moyen // quelques commodités
  grand // tout inclus
}

// Standing et gamme (10/11/2026) : même échelle économique / moyen / grand.
// Standing = potentiel de l'ouvrage en commodités ; gamme = en finitions.
enum Gamme {
  economique
  moyen
  grand
}

enum TypeClient {
  particulier
  sci
  entreprise
  institution
}

// -- Clients --

model Client {
  id        String     @id @default(uuid())
  societeId String     @map("societe_id")
  // Référence client « CL-0009 » (maquette Finances, oct. 2026) : rang dans la
  // société, attribué à la création.
  numero    Int?
  nom       String
  type      TypeClient
  // Sigle choisi par l'entreprise elle-même — obligatoire pour une personne
  // morale (sci/entreprise/institution) : c'est le segment CLIENT du code
  // dossier (cf. crm/nomenclature.ts), jamais dérivé du nom. Stocké normalisé
  // (majuscules, lettres/chiffres). null pour un particulier.
  sigle     String?
  contact   String?
  email     String?
  telephone String?
  // Adresse reprise sur les devis et les factures ; "" = à renseigner.
  adresse   String     @default("")
  // NINEA d'une entreprise cliente, imprimé sur ses factures (lot 6) ; vide = non renseigné.
  ninea     String     @default("")
  createdAt DateTime   @default(now()) @map("created_at")

  societe   Societe            @relation(fields: [societeId], references: [id], onDelete: Cascade)
  dossiers  DossierCrm[]
  projets   Projet[]
  devis     Devis[]
  decisions DecisionRegistre[]

  @@unique([societeId, numero])
  @@map("clients")
}

// -- Référentiel des localités (partagé par TOUTES les sociétés du HUB) --
//
// Source : fichier « Référentiel des localités — HUB360° » (sept. 2026),
// importé tel quel par la migration localites_referentiel. Règles métier du
// fichier, appliquées ici et dans LocalitesService :
//   · code = 3 lettres majuscules, unique sur l'ensemble des trois zones
//     (un quartier ne peut pas reprendre le code ISO d'un pays) ;
//   · seule la direction (societe_admin ou CIO) ajoute une localité ;
//   · un code déjà utilisé par un dossier ne se modifie jamais — on corrige
//     le nom d'affichage, pas le code.
// Pas de societeId : une localité ne change pas de sens selon la société.

enum ZoneLocalite {
  dakar // onglet « Dakar » — région de Dakar
  senegal // onglet « Villes Sénégal » — reste du pays
  pays // onglet « Pays » — code ISO 3166-1 alpha-3
}

model Localite {
  id             String       @id @default(uuid())
  code           String       @unique
  nom            String
  zone           ZoneLocalite
  // département (Dakar) / région (Sénégal) / zone géographique (Pays)
  region         String
  arrondissement String? // Dakar uniquement, quand le fichier le précise
  // Quartier d'usage rattaché à sa commune administrative d'origine (ex.
  // Point E → « Fann-Point E-Amitié ») — traçabilité, pas de hiérarchie.
  commune        String?
  ordre          Int          @default(0)
  createdAt      DateTime     @default(now()) @map("created_at")

  dossiers DossierCrm[]

  @@index([zone, ordre])
  @@map("localites")
}

// -- Dossier CRM : la ligne du pipeline de prospection, avant validation --

enum TypeApporteur {
  interne // le créateur de la fiche, compte HUB
  externe // tiers (notaire, partenaire, recommandation…)
}

model DossierCrm {
  id                     String         @id @default(uuid())
  societeId              String         @map("societe_id")
  code                   String
  nature                 NatureDossier
  // Champs de la fiche : un lead peut être créé incomplet (seuls client et
  // localité, qui composent le code, sont requis) ; null / 0 / "" = à
  // renseigner. Complète (crm/fiche.ts) avant toute offre.
  categorie              Categorie?
  // Libellé affiché (= nom de la localité pour tout dossier créé depuis le
  // référentiel ; texte libre historique pour les dossiers antérieurs).
  localisation           String
  // null = dossier antérieur au référentiel, pas encore rattaché (à la main,
  // par l'admin — jamais de rapprochement automatique sur le texte libre).
  localiteId             String?        @map("localite_id")
  latitude               Float? // pin géo optionnel, copié vers le Projet au pivot
  longitude              Float?
  // Plus saisi depuis le 09/11/2026 (forme bâtie de la Fiche Programme) ;
  // gardé pour les dossiers antérieurs.
  type                   TypeBien?
  nbPlanches             Int            @default(0) @map("nb_planches")
  surfaceTerrain         Int            @default(0) @map("surface_terrain")
  standing               Standing?
  gamme                  Gamme?
  programme              String         @default("")
  statut                 StatutCrm      @default(nouveau_projet)
  clientId               String         @map("client_id")
  // -- « Qui » (étape C1, sept. 2026). Tous null sur les dossiers antérieurs.
  creeParId              String?        @map("cree_par_id")
  // Fiche apporteur d'affaire, validée et verrouillée à la création, puis
  // modifiable par le COO seul (maquette « Nouveau projet », oct. 2026).
  // null = aucun apporteur (affaire directe) — ou dossier antérieur à la
  // fiche ; externe = tiers saisi (nom, structure, coordonnées, % attribué) ;
  // interne = le créateur lui-même, plus proposé à la création (dossiers
  // antérieurs seulement). Commission = % attribué, pas fixes (3 à 5 %) —
  // partie de la fiche apporteur, lue par les rôles CRM.
  apporteurType          TypeApporteur? @map("apporteur_type")
  apporteurUtilisateurId String?        @map("apporteur_utilisateur_id")
  apporteurNom           String?        @map("apporteur_nom")
  apporteurStructure     String?        @map("apporteur_structure") // « Notaire, partenaire… »
  apporteurTelephone     String?        @map("apporteur_telephone")
  apporteurEmail         String?        @map("apporteur_email")
  commissionApporteur    Decimal?       @map("commission_apporteur") @db.Decimal(3, 1)
  // Propriétaire = responsable qui suit le dossier : un titulaire du rôle
  // Dir. GC de la société. null = « à assigner » (aucun titulaire à la
  // création) — jamais bloquant. Réassignable (cf. CrmService).
  proprietaireId         String?        @map("proprietaire_id")
  // Catégorie de conception (CO1/CO2/CO3) — fixée par la ligne CO de l'offre
  // à son envoi (validation DAF). SU (et plus tard TS) en découlent.
  // Fiche Programme dynamique (crm/fiche-programme.ts) : usage, forme bâtie,
  // gabarit, composition, commodités… null = pas commencée. Le programme
  // (résumé) et, quand ils se calculent, les planches en sont déduits.
  ficheProgramme         Json?          @map("fiche_programme")
  categorieConception    String?        @map("categorie_conception")
  // Lead archivé (maquette CRM du boss) : un lead incomplet ou mal renseigné
  // s'archive, il ne se supprime jamais — consultable dans « Archivés », son
  // code reste réservé. Définitif, possible en « Nouveau projet » seulement.
  archiveLe              DateTime?      @map("archive_le")
  archiveParId           String?        @map("archive_par_id")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  societe              Societe                @relation(fields: [societeId], references: [id], onDelete: Cascade)
  client               Client                 @relation(fields: [clientId], references: [id])
  // Restrict : une localité référencée ne peut pas disparaître sous un dossier.
  localite             Localite?              @relation(fields: [localiteId], references: [id], onDelete: Restrict)
  creePar              Utilisateur?           @relation("DossierCreePar", fields: [creeParId], references: [id], onDelete: SetNull)
  apporteurUtilisateur Utilisateur?           @relation("DossierApporteur", fields: [apporteurUtilisateurId], references: [id], onDelete: SetNull)
  proprietaire         Utilisateur?           @relation("DossierProprietaire", fields: [proprietaireId], references: [id], onDelete: SetNull)
  archivePar           Utilisateur?           @relation("DossierArchivePar", fields: [archiveParId], references: [id], onDelete: SetNull)
  projet               Projet? // 0..1 — créé au passage à onboard (transaction pivot)
  transitions          DossierCrmTransition[]
  commissions          CommissionApporteur[]
  coordonneesApporteur CoordonneesApporteur[]
  offres               Devis[] // la plus récente = l'offre en cours (étape F)
  contrat              Contrat? // étape G — sa signature déclenche l'Onboard
  notifications        Notification[]
  factures             Facture[] // factures directes (sans offre)

  @@unique([societeId, code])
  @@index([localiteId])
  @@map("dossiers_crm")
}

// -- Journal du cycle commercial : une ligne par changement de statut (et une
//    à la création, `de` null). Porte le motif d'un passage à « perdu » et le
//    commentaire de la DAF quand elle renvoie un dossier — trace d'audit (qui
//    a validé quoi) et base des futurs calculs de délais du pipeline.
// Journal de la fiche : une ligne par changement de statut. de = vers = un
// événement de la fiche sans changement d'étape (fiche apporteur modifiée par
// le COO), décrit par `commentaire`. de = null = création ; son commentaire
// garde la fiche apporteur telle que validée.
model DossierCrmTransition {
  id          String     @id @default(uuid())
  dossierId   String     @map("dossier_id")
  de          StatutCrm?
  vers        StatutCrm
  // null = reprise de données (migration) ou le client lui-même (refus via
  // le lien public de l'offre).
  parId       String?    @map("par_id")
  commentaire String?
  creeLe      DateTime   @default(now()) @map("cree_le")

  dossier DossierCrm   @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  par     Utilisateur? @relation("TransitionDossierPar", fields: [parId], references: [id], onDelete: SetNull)

  @@index([dossierId, creeLe])
  @@map("dossier_crm_transitions")
}

// -- Contrat (étape G, cadrage validé 27/09/2026) -----------------------------
//   · un contrat par dossier CRM, préparé une fois l'offre ACCEPTÉE ;
//   · mode `modele` (offre HT < seuil société) : texte généré depuis le modèle
//     société, figé à la génération ; mode `sur_mesure` (≥ seuil) : document
//     rédigé à part, téléversé ;
//   · annexes selon la liste société (offre acceptée jointe d'office, les
//     autres : fichier joint ou « non nécessaire ») ;
//   · signature client : bouton « J'accepte », signature tracée à l'écran
//     (horodatée, IP) — via lien public à jeton — ou contrat papier scanné
//     téléversé par l'équipe ;
//   · la SIGNATURE fait passer le dossier en « onboard » (projet + factures
//     brouillon, cf. CrmService) — plus de clic Onboard manuel.

enum ModeContrat {
  modele
  sur_mesure
}

enum StatutContrat {
  brouillon
  envoye
  signe
}

enum ModeSignatureContrat {
  bouton // « J'accepte » sur le lien public
  trace // signature tracée à l'écran sur le lien public
  papier // contrat papier signé, scanné, téléversé par l'équipe
}

enum StatutAnnexeContrat {
  a_joindre
  jointe
  non_necessaire
}

// Liste d'annexes par société (Paramètres → Contrats), même principe que les
// gabarits Foncier / Études. `automatique` = « offre » : l'offre acceptée du
// dossier, jointe d'office (jamais un fichier à téléverser).
model AnnexeContratGabarit {
  id          String    @id @default(uuid())
  societeId   String    @map("societe_id")
  libelle     String
  automatique String? // 'offre' | null
  ordre       Int       @default(0)
  supprimeLe  DateTime? @map("supprime_le")

  societe Societe @relation(fields: [societeId], references: [id], onDelete: Cascade)

  @@index([societeId])
  @@map("annexes_contrat_gabarit")
}

model Contrat {
  id                 String                @id @default(uuid())
  societeId          String                @map("societe_id")
  dossierCrmId       String                @unique @map("dossier_crm_id")
  devisId            String                @map("devis_id") // l'offre acceptée
  mode               ModeContrat
  statut             StatutContrat         @default(brouillon)
  // Figés à la préparation / génération (le contrat ne bouge plus si les
  // réglages société changent ensuite).
  contenu            String? // mode modele : texte généré
  montantOffreHt     Decimal               @map("montant_offre_ht") @db.Decimal(14, 0)
  signataireNom      String                @map("signataire_nom")
  signataireFonction String                @map("signataire_fonction")
  // mode sur_mesure : le contrat rédigé à part (data URI, seam S3 comme
  // FichierProjet).
  documentNom        String?               @map("document_nom")
  documentUrl        String?               @map("document_url")
  tokenPublicHash    String?               @unique @map("token_public_hash")
  dateEnvoi          DateTime?             @map("date_envoi")
  signeLe            DateTime?             @map("signe_le")
  modeSignature      ModeSignatureContrat? @map("mode_signature")
  signeParNom        String?               @map("signe_par_nom") // nom saisi par le client
  signatureTrace     String?               @map("signature_trace") // PNG data URI (mode trace)
  signeIp            String?               @map("signe_ip")
  scanNom            String?               @map("scan_nom") // mode papier
  scanUrl            String?               @map("scan_url")
  creeLe             DateTime              @default(now()) @map("cree_le")

  societe Societe         @relation(fields: [societeId], references: [id], onDelete: Cascade)
  dossier DossierCrm      @relation(fields: [dossierCrmId], references: [id], onDelete: Cascade)
  devis   Devis           @relation(fields: [devisId], references: [id])
  annexes AnnexeContrat[]

  @@map("contrats")
}

model AnnexeContrat {
  id          String              @id @default(uuid())
  contratId   String              @map("contrat_id")
  libelle     String
  automatique String? // 'offre' : l'offre acceptée, jointe d'office
  statut      StatutAnnexeContrat @default(a_joindre)
  fichierNom  String?             @map("fichier_nom")
  fichierUrl  String?             @map("fichier_url")
  ordre       Int                 @default(0)

  contrat Contrat @relation(fields: [contratId], references: [id], onDelete: Cascade)

  @@index([contratId])
  @@map("annexes_contrat")
}

// -- Projet : l'instance d'exécution. Champs métier = snapshot du dossier --

model Projet {
  id               String        @id @default(uuid())
  societeId        String        @map("societe_id")
  dossierCrmId     String        @unique @map("dossier_crm_id")
  code             String
  // snapshot pris à la validation du dossier
  nature           NatureDossier
  categorie        Categorie
  programme        String
  localisation     String
  // Facultatif depuis le 09/11/2026 : la fiche ne demande plus le type, la
  // forme bâtie de la Fiche Programme le remplace ; repris s'il existe.
  type             TypeBien?
  clientId         String        @map("client_id")
  // localisation géo — pin posé à la main, copié du dossier au pivot
  latitude         Float?
  longitude        Float?
  // exécution
  statut           StatutProjet  @default(a_assigner)
  phase            Phase         @default(avant_projet)
  // Ouverture selon le gabarit (Réglages · « Ouverture du projet » : à
  // l'émission de F1) : J1 et la version recopiée en cartes et tâches. null =
  // pas encore ouvert (ou catégorie sans gabarit).
  ouvertLe         String?       @map("ouvert_le") // J1, AAAA-MM-JJ
  gabaritVersionId String?       @map("gabarit_version_id")
  // Budget atelier en service à l'ouverture (Réglages) : horizon J1 →
  // livraison = budget / 8 h. Figé, comme les fenêtres.
  budgetHeures     Int?          @map("budget_heures")
  // Visite sur site (AAAA-MM-JJ) : les relevés de l'existant sont dus 24 h
  // calendaires après (règle du gabarit, carte « Relevés existants »).
  dateVisiteSite   String?       @map("date_visite_site")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  societe           Societe             @relation(fields: [societeId], references: [id], onDelete: Cascade)
  dossierCrm        DossierCrm          @relation(fields: [dossierCrmId], references: [id], onDelete: Cascade)
  client            Client              @relation(fields: [clientId], references: [id])
  // Plusieurs équipes par projet (décision boss, sept. 2026 — remplace « 1
  // projet = 1 cellule »). Collaborateur.celluleId reste singulier : un
  // collaborateur suit un projet si SA cellule fait partie des cellules du
  // projet (cf. projet-acces.ts).
  cellules          ProjetCellule[]
  // phase 2 — sections aval (conception : les 3 ; aménagement : execution seul)
  etudes            Etudes?
  notifications     Notification[]
  factures          Facture[]
  devis             Devis[]
  validationsTaches ValidationTache[]
  demandesTs        DemandeTs[]
  decisions         DecisionRegistre[]
  gabaritVersion    GabaritVersion?     @relation(fields: [gabaritVersionId], references: [id])
  cartes            CarteProjet[]
  taches            TacheProjet[]
  commentaires      CommentaireProjet[]

  modifications ModificationProjet[]

  canal Canal?

  @@map("projets")
}

// -- Équipe : 6 cellules cross-fonctionnelles (Archi 1-4, Intérieur, Études).
//    Renommé depuis SousGroupe (vocabulaire métier — le studio dit « cellule »).
//    Un projet peut être suivi par PLUSIEURS cellules (décision boss, sept.
//    2026 — remplace « 1 projet = 1 cellule », cf. ProjetCellule) ; un
//    collaborateur, lui, reste rattaché à une seule cellule (celluleId sur
//    Collaborateur, inchangé).

model Cellule {
  id           String           @id @default(uuid())
  societeId    String           @map("societe_id")
  nom          String
  // Le membre de CETTE cellule habilité à répartir les tâches aux autres
  // (décision boss, sept. 2026) — un seul par cellule, désigné par l'admin
  // uniquement (cf. CellulesService.definirDispatcher, même pattern que
  // « responsable d'un bloc » pour Permis/Exécution). Doit appartenir à la
  // cellule (vérifié en service, pas en contrainte DB) ; SetNull si retiré
  // de l'équipe ou si son compte est supprimé.
  dispatcherId String?          @map("dispatcher_id")
  // Nomenclature ISO 9001 (maquette « Équipes », oct. 2026) : code
  // SOCIÉTÉ-PROCESSUS-NN, stable et jamais réutilisé (CompteurCellule) ; le
  // nom d'usage (`nom`) et la clientèle peuvent évoluer. Le pilote (§5.3) est
  // le dispatcher ci-dessus (« chef de team »).
  processus    ProcessusCellule
  numero       Int
  code         String
  clientele    ClienteleCellule @default(externes)
  statut       StatutCellule    @default(active)
  createdAt    DateTime         @default(now()) @map("created_at")

  societe    Societe            @relation(fields: [societeId], references: [id], onDelete: Cascade)
  membres    Collaborateur[]    @relation("CelluleMembre")
  dispatcher Collaborateur?     @relation("CelluleDispatcher", fields: [dispatcherId], references: [id], onDelete: SetNull)
  projets    ProjetCellule[]
  canal      Canal? // fil de discussion permanent de la cellule (0..1)
  postes     PosteCellule[]
  decisions  DecisionRegistre[]

  @@unique([societeId, code])
  @@map("cellules")
}

// Processus d'une cellule (ISO 9001) : DIR §5 / §9.3, ARC et INT §8.3, ETU §8.4.
enum ProcessusCellule {
  DIR
  ARC
  INT
  ETU
}

enum ClienteleCellule {
  externes // clients externes
  holding // interne (Holding)
  tous // tous projets
  sans_objet
}

enum StatutCellule {
  active
  a_constituer
  reportee
}

enum EtatPosteCellule {
  occupe // un titulaire
  ouvert // poste ouvert, à affecter
  reporte
  a_recruter
  externe // prestataires (bureaux d'études)
}

// Postes d'une cellule (CAD L1, Head of Interior Architecture…), dans l'ordre.
model PosteCellule {
  id          String           @id @default(uuid())
  celluleId   String           @map("cellule_id")
  libelle     String
  ordre       Int              @default(0)
  etat        EtatPosteCellule @default(ouvert)
  titulaireId String?          @map("titulaire_id")

  cellule   Cellule        @relation(fields: [celluleId], references: [id], onDelete: Cascade)
  titulaire Collaborateur? @relation("PosteTitulaire", fields: [titulaireId], references: [id], onDelete: SetNull)

  @@index([celluleId])
  @@index([titulaireId])
  @@map("postes_cellule")
}

// Dernier numéro attribué par société et processus : un code de cellule
// n'est jamais réutilisé, même après suppression.
model CompteurCellule {
  societeId String           @map("societe_id")
  processus ProcessusCellule
  dernier   Int

  societe Societe @relation(fields: [societeId], references: [id], onDelete: Cascade)

  @@id([societeId, processus])
  @@map("compteurs_cellule")
}

// Table de liaison Projet <-> Cellule (many-to-many). Pas de champ propre
// au-delà des deux FK : l'appartenance elle-même est l'information, il n'y a
// pas de rôle par ligne (ça, c'est le « dispatcher » sur Cellule, au-dessus).
model ProjetCellule {
  projetId  String   @map("projet_id")
  celluleId String   @map("cellule_id")
  creeLe    DateTime @default(now()) @map("cree_le")

  projet  Projet  @relation(fields: [projetId], references: [id], onDelete: Cascade)
  cellule Cellule @relation(fields: [celluleId], references: [id], onDelete: Cascade)

  @@id([projetId, celluleId])
  @@map("projet_cellules")
}

enum NiveauCollaborateur {
  stagiaire
  junior
  confirme
  senior
  lead
}

model Collaborateur {
  id            String              @id @default(uuid())
  // societeId direct : un collaborateur peut être orphelin de cellule
  // (celluleId null) mais reste rattaché à sa société (isolation multi-société).
  societeId     String              @map("societe_id")
  celluleId     String?             @map("cellule_id")
  prenom        String
  nom           String
  role          String // métier : « Architecte », « Designer », « Dessinateur »…
  niveau        NiveauCollaborateur @default(confirme) // séniorité (2ᵉ axe)
  photoCle      String?             @map("photo_cle") // data URI puis clé S3 (seam ImageProjet.cle)
  utilisateurId String?             @map("utilisateur_id") // comptes collaborateurs plus tard
  // Entrée dans le studio, saisie par l'admin (AAAA-MM-JJ). Distinct de
  // createdAt (création de la fiche) : sert l'ancienneté sur « Mes indicateurs ».
  // Nullable — pas de date improvisée quand elle n'est pas renseignée.
  dateArrivee   String?             @map("date_arrivee")
  createdAt     DateTime            @default(now()) @map("created_at")

  societe           Societe        @relation(fields: [societeId], references: [id], onDelete: Cascade)
  cellule           Cellule?       @relation("CelluleMembre", fields: [celluleId], references: [id], onDelete: SetNull)
  // Back-relation de Cellule.dispatcherId — un tableau car non-`@unique` en
  // base, mais en pratique jamais plus de 1 élément (la désignation exige
  // d'appartenir à la cellule, donc « être dispatcher de 2 cellules à la
  // fois » impliquerait d'être membre des deux, impossible avec celluleId
  // singulier).
  celluleDispatchee Cellule[]      @relation("CelluleDispatcher")
  utilisateur       Utilisateur?   @relation(fields: [utilisateurId], references: [id])
  tachesProjet      TacheProjet[]  @relation("TacheProjetAssigne")
  postesCellule     PosteCellule[] @relation("PosteTitulaire")

  dossierPersonnel DossierPersonnel?

  @@map("collaborateurs")
}

// -- Section Avant-projet : fiche programme + validation (1:1 avec Projet) --

// -- Section Pré-bilan : chiffrage versionné. Pas de table « PreBilan »
//    propre — les versions pendent du Projet, le DTO reconstitue la forme
//    { projetId, versions[] } attendue par le front. --

// =============================================================================
// Grey Concrete — phase 2 : permis de construire, études techniques, exécution,
// images. Migration additive (aucune donnée existante pour ces modèles).
// Décisions figées — artifact « Backend Grey Concrete » §08 :
//   · remise ≠ validee : deux valeurs d'enum distinctes (StatutEtude), pas un booléen ;
//   · ImageProjet strict — pas de Document générique tant qu'il n'y a qu'une nature ;
//   · dates « agenda » (remise BET) en String AAAA-MM-JJ ; horodatages (validation) en DateTime.
// Permis (sept. 2026) et Exécution (sept. 2026) ont depuis été refondus en
// checklists Trello par blocs (BlocPermis/LigneChecklistPermis,
// BlocExecution/LigneChecklistExecution) — le journal générique EntreeJournal
// et le suivi lots/offres/situations/réception ont été retirés, cf. mémoire.
// =============================================================================

// -- Vocabulaire métier (fermé) — miroir de frontend/lib/types.ts --

enum TypeEtude {
  geotechnique
  topographie
  structure
  fluides
  electricite
  vrd
}

enum StatutEtude {
  a_lancer
  en_cours
  remise
  validee
  non_requise
}

// -- Section « Études » (conception) : en-tête 1:1 (comme AvantProjet) + lignes --
model Etudes {
  projetId     String    @id @map("projet_id")
  dceConstitue Boolean   @default(false) @map("dce_constitue")
  dceLe        DateTime? @map("dce_le")

  projet Projet      @relation(fields: [projetId], references: [id], onDelete: Cascade)
  // LigneEtude (6 types figés, TypeEtude) laissée dormante — restructuration
  // sept. 2026 en blocs configurables par gabarit société (BlocEtude
  // ci-dessous), même motif que dossier_final/checklist Avant-projet avant
  // elle : rien supprimé, juste plus jamais lu/écrit par le service.
  blocs  BlocEtude[]

  @@map("etudes")
}

// -- Études techniques restructurées en blocs configurables (sept. 2026) —
//    chaque type d'étude (géotechnique, structure…) n'est plus une ligne
//    figée dans un tableau unique mais son propre bloc, avec un bureau
//    d'études (interlocuteur+contact), une facture (admin/CIO uniquement) et
//    ses propres livrables (ItemEtude) en checklist à fichiers, même modèle
//    que Foncier (statut dérivé + case à cocher manuelle, cf.
//    LigneUnbord.fait). Blocs ET items configurables par gabarit société
//    (societe_admin ou CIO) — même pattern que LigneUnbordGabarit, mais avec
//    un niveau de nesting en plus puisque les BLOCS eux-mêmes sont
//    configurables ici (pas juste les items dans des blocs fixes). --

model BlocEtude {
  id                   String      @id @default(uuid())
  projetId             String      @map("projet_id")
  // Carte de l'étape 05 du gabarit (phase 1, 14/10/2026) : la facture du
  // bureau se saisit dans Finances, une étude par carte.
  carteProjetId        String?     @map("carte_projet_id")
  // Libellé de l'étude (repris de la carte du gabarit à la création).
  libelle              String
  interlocuteur        String      @default("") // ex-« bet » (nom du bureau d'études)
  contactInterlocuteur String      @default("") @map("contact_interlocuteur")
  statut               StatutEtude @default(a_lancer)
  dateRemisePrevue     String?     @map("date_remise_prevue") // AAAA-MM-JJ
  dateRemiseReelle     String?     @map("date_remise_reelle")
  note                 String      @default("")
  // Facture du bureau : saisie dans Finances (écriture sur les factures),
  // jamais montrée hors des rôles Finances.
  factureMontant       Decimal?    @map("facture_montant") @db.Decimal(14, 0)
  factureFichierNom    String?     @map("facture_fichier_nom")
  factureFichierCle    String?     @map("facture_fichier_cle")
  // Règlement du bureau par Grey Concrete (étape H3, CGV art. 5 : seulement
  // APRÈS encaissement du client). « À régler » est dérivé (facture de
  // refacturation soldée) ; seul le règlement effectif est saisi — CFO,
  // module finances_charges.
  bureauRegleLe        DateTime?   @map("bureau_regle_le")
  bureauRegleParId     String?     @map("bureau_regle_par_id") // audit, pas de FK
  supprimee            Boolean     @default(false)
  supprimeLe           DateTime?   @map("supprime_le")
  supprimeParId        String?     @map("supprime_par_id")

  etudes        Etudes         @relation(fields: [projetId], references: [projetId], onDelete: Cascade)
  carteProjet   CarteProjet?   @relation(fields: [carteProjetId], references: [id], onDelete: SetNull)
  supprimePar   Utilisateur?   @relation("BlocEtudeSupprPar", fields: [supprimeParId], references: [id], onDelete: SetNull)
  lignesFacture LigneFacture[] // refacturation(s) — une seule active à la fois

  @@unique([projetId, carteProjetId])
  @@map("blocs_etude")
}

// =============================================================================
// Chat multi-canaux (lot 3) — cf. artifact « Chat multi-canaux » (cadrage v1.0).
// 3 types de canaux : fil permanent par cellule, un Général par société, DM à
// deux. `societeId` sur Canal = invariant multi-société. Canaux créés en
// coquille lazy (comme AvantProjet/Etudes), messages immuables v1. Réception
// temps réel par SSE ; l'envoi passe par l'API REST (mêmes gardes).
// =============================================================================

enum TypeCanal {
  cellule
  general
  direct
  groupe // groupe de discussion : nom et membres choisis (01/11/2026)
  projet // conversation d'un projet, membres tenus à jour automatiquement (02/11/2026)
}

model Canal {
  id             String    @id @default(uuid())
  societeId      String    @map("societe_id")
  type           TypeCanal
  // type = cellule uniquement — @unique : un seul fil par cellule.
  celluleId      String?   @unique @map("cellule_id")
  // type = direct uniquement — l'appelant range participant1Id < participant2Id
  // (ordre canonique) ; le @@unique garantit un seul DM par paire.
  participant1Id String?   @map("participant1_id")
  participant2Id String?   @map("participant2_id")
  // type = groupe : nom et créateur (il gère les membres).
  nom            String?
  creeParId      String?   @map("cree_par_id")
  // type = projet : le projet (une conversation par projet).
  projetId       String?   @unique @map("projet_id")
  createdAt      DateTime  @default(now()) @map("created_at")

  societe       Societe        @relation(fields: [societeId], references: [id], onDelete: Cascade)
  cellule       Cellule?       @relation(fields: [celluleId], references: [id], onDelete: Cascade)
  participant1  Utilisateur?   @relation("CanalDmP1", fields: [participant1Id], references: [id])
  participant2  Utilisateur?   @relation("CanalDmP2", fields: [participant2Id], references: [id])
  messages      Message[]
  lectures      LectureCanal[]
  membres       MembreCanal[]
  notifications Notification[]
  projet        Projet?        @relation(fields: [projetId], references: [id], onDelete: Cascade)

  @@unique([participant1Id, participant2Id])
  // Unicité du Général par société : index partiel posé en SQL brut dans la
  // migration — CREATE UNIQUE INDEX ... ("societe_id") WHERE type = 'general'.
  @@map("canaux")
}

model Message {
  id         String    @id @default(uuid())
  canalId    String    @map("canal_id")
  // FK sans onDelete → Restrict par défaut : on ne supprime pas un compte qui a
  // écrit (convention « on désactive, on ne supprime pas », cf. Utilisateur.desactiveLe).
  auteurId   String    @map("auteur_id")
  texte      String // plafonné à ~4000 au DTO
  // Ligne d'information d'un groupe (« X a ajouté Y »), pas un message.
  systeme    Boolean   @default(false)
  // Personnes mentionnées (@) : identifiants de compte.
  mentions   String[]  @default([])
  // Réponse à un message ; modifié ou supprimé par son auteur (15 min).
  reponseAId String?   @map("reponse_a_id")
  modifieLe  DateTime? @map("modifie_le")
  supprimeLe DateTime? @map("supprime_le")
  createdAt  DateTime  @default(now()) @map("created_at")

  canal     Canal             @relation(fields: [canalId], references: [id], onDelete: Cascade)
  auteur    Utilisateur       @relation(fields: [auteurId], references: [id])
  reponseA  Message?          @relation("ReponseMessage", fields: [reponseAId], references: [id], onDelete: SetNull)
  reponses  Message[]         @relation("ReponseMessage")
  pieces    PieceMessage[]
  reactions ReactionMessage[]

  @@index([canalId, createdAt])
  @@map("messages")
}

// Curseur de lecture par (utilisateur, canal). Le non-lu se déduit :
// COUNT(messages WHERE created_at > dernierLuLe AND auteur_id <> moi).
model LectureCanal {
  utilisateurId String   @map("utilisateur_id")
  canalId       String   @map("canal_id")
  dernierLuLe   DateTime @map("dernier_lu_le")

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  canal       Canal       @relation(fields: [canalId], references: [id], onDelete: Cascade)

  @@id([utilisateurId, canalId])
  @@map("lectures_canal")
}

// =============================================================================
// Facturation client (brique « gestion ») — cf. cadrage « Facturation client ».
// Migration additive (aucune donnée existante). Le pré-bilan chiffre un projet ;
// ce module transforme ce chiffrage en factures réelles, émises, suivies, payées.
// Décisions figées du cadrage :
//   · §2  type dérivé de projet.nature (mandat_client → honoraires ;
//         promotion_interne → vente) — jamais saisi ; stocké dénormalisé car
//         c'est ce qui figure sur la facture ;
//   · §5  numéro séquentiel PAR SOCIÉTÉ (invariant societeId), attribué à
//         l'émission — un brouillon n'a pas de numéro, donc sa suppression ne
//         laisse pas de trou ; immuable ensuite ;
//   · §5  une facture émise ne se modifie plus : correction = avoir (estAvoir +
//         factureOrigineId, montants signés négatifs), jamais d'édition ;
//   · §4  seuls montantHt + tauxTva sont stockés ; TVA / TTC dérivés à la
//         lecture (mêmes valeurs figées, une seule source — comme le total du
//         pré-bilan) ;
//   · §6  statut stocké = cycle piloté par l'admin (brouillon → emise →
//         annulee) ; partiellement_payee / payee / en_retard sont dérivés à la
//         lecture du cumul des paiements et de l'échéance — pas de scheduler ;
//   · §7  Paiement pend de la Facture (comme SituationPaiement pend du Lot) ;
//   · §3  dates « échéance » / « versement » en String AAAA-MM-JJ (date agenda) ;
//         horodatages (création, émission, annulation) en DateTime.
// =============================================================================

enum FactureType {
  honoraires // nature = mandat_client — prestations de conception / suivi
  vente // nature = promotion_interne — bien vendu à l'acheteur final
}

enum FactureStatut {
  brouillon
  emise
  annulee // remplacée par un avoir
}

// Les 3 jalons standard d'un échéancier de facturation (mandat client).
enum JalonFacture {
  signature
  avant_projet
  livraison
}

enum ModePaiement {
  virement
  cheque
  especes
  wave // mobile money — distingués (décision 27/09/2026)
  orange_money
}

model Facture {
  id                String        @id @default(uuid())
  societeId         String        @map("societe_id")
  // Nullable depuis le module Devis (cf. cadrage « Devis ») : une facture
  // convertie depuis un devis « libre » (sans projet) doit pouvoir exister
  // sans projetId. Tout le flux existant (échéancier par jalon) continue de
  // toujours renseigner projetId — seule la contrainte est desserrée.
  projetId          String?       @map("projet_id")
  numero            Int? // rang séquentiel par société — null tant que brouillon
  // Référence affichée (maquette Finances, oct. 2026) : code du dossier +
  // rang de la facture dans ce dossier, « D_ALM.26-1 », attribués à
  // l'émission (un brouillon n'en a pas : sa suppression ne laisse pas de
  // trou). null = facture sans dossier (devis libre) : référence F-AAAA-NNNN.
  codeDossier       String?       @map("code_dossier")
  rangDossier       Int?          @map("rang_dossier")
  type              FactureType
  statut            FactureStatut @default(brouillon)
  jalon             JalonFacture? // renseigné si la facture appartient à un échéancier
  libelle           String        @default("")
  montantHt         Decimal       @default(0) @map("montant_ht") @db.Decimal(14, 0)
  tauxTva           Decimal       @default(18) @map("taux_tva") @db.Decimal(5, 2)
  echeanceLe        String?       @map("echeance_le") // AAAA-MM-JJ (date agenda)
  estAvoir          Boolean       @default(false) @map("est_avoir")
  factureOrigineId  String?       @map("facture_origine_id") // avoir → facture annulée
  // Devis converti (cf. Devis.statut = transforme) — même idiome que
  // factureOrigineId ci-dessus : le document dérivé porte le lien vers son
  // origine. Le détail ligne par ligne reste sur le Devis, jamais dupliqué
  // ici (Facture reste à montant unique, cf. cadrage §Devis).
  devisOrigineId    String?       @unique @map("devis_origine_id")
  // Étape H2 : factures préparées à l'Onboard depuis l'offre acceptée d'un
  // dossier CRM (échéancier 40/40/20 de la conception, 50/50 par permis,
  // images, autres lignes) — plusieurs par offre, d'où ce lien distinct de
  // devisOrigineId (conversion 1 devis → 1 facture, devis libres).
  devisEcheancierId String?       @map("devis_echeancier_id")
  // Échéance de l'offre que la facture règle (clé de facturation-offre.ts :
  // CO:F1, DPC:solde, IM:18…) — rapprochement avec le délai prévu (Finances).
  cleEcheance       String?       @map("cle_echeance")
  // Mensualité d'une ligne SU / EX de l'offre (facturation mensuelle
  // manuelle, CGV : forfait mensuel) — une facture par mois facturé.
  ligneDevisId      String?       @map("ligne_devis_id")
  // Facture directe d'un lead (sans offre) : préparée depuis le CRM ou
  // Finances, validée par le CFO avant émission (« À valider CFO »). Le
  // projet est rattaché quand il existe (Onboard).
  dossierCrmId      String?       @map("dossier_crm_id")
  // Numéro légal (lot 6, à la manière de Zervant) : figé à l'émission selon
  // le format en vigueur (préfixe, année, séquence sans trou par préfixe et
  // par année, commune aux factures et aux avoirs). null = facture émise
  // avant ce format : son numéro reste l'ancien « F2026-0007 » (refFacture).
  reference         String?
  refPrefixe        String?       @map("ref_prefixe")
  refAnnee          Int?          @map("ref_annee")
  refSequence       Int?          @map("ref_sequence")
  creeLe            DateTime      @default(now()) @map("cree_le")
  emiseLe           DateTime?     @map("emise_le")
  // Ordre réel de l'événement dans le journal d'audit, posé par la base
  // (séquence commune, migration 20261026090000_ordre_journal).
  ordreEmission     BigInt?       @map("ordre_emission")
  emiseParId        String?       @map("emise_par_id") // audit, pas de FK
  annuleeLe         DateTime?     @map("annulee_le")

  societe         Societe        @relation(fields: [societeId], references: [id], onDelete: Cascade)
  projet          Projet?        @relation(fields: [projetId], references: [id], onDelete: Cascade)
  factureOrigine  Facture?       @relation("FactureAvoir", fields: [factureOrigineId], references: [id])
  avoirs          Facture[]      @relation("FactureAvoir")
  devisOrigine    Devis?         @relation("DevisConversion", fields: [devisOrigineId], references: [id])
  devisEcheancier Devis?         @relation("DevisEcheancier", fields: [devisEcheancierId], references: [id], onDelete: SetNull)
  ligneDevis      LigneDevis?    @relation(fields: [ligneDevisId], references: [id], onDelete: SetNull)
  dossierCrm      DossierCrm?    @relation(fields: [dossierCrmId], references: [id], onDelete: Restrict)
  notifications   Notification[]
  paiements       Paiement[]
  lignes          LigneFacture[]
  demandesAvoir   DemandeAvoir[]

  @@unique([societeId, numero])
  @@unique([societeId, refPrefixe, refAnnee, refSequence])
  @@unique([societeId, codeDossier, rangDossier])
  @@index([projetId])
  @@index([ligneDevisId])
  @@map("factures")
}

// Lignes d'une facture (étape H3, option B confirmée par le boss : les études
// refacturées « figurent sur lignes distinctes de la facture », CGV art. 5).
// ADDITIF : une facture sans lignes reste à montant unique, comme avant. Avec
// lignes, Facture.montantHt reste le total stocké (= somme des lignes, tenu
// par le service) et un SEUL taux de TVA par facture (Facture.tauxTva) —
// statuts, paiements, avoirs, relances et tableau de bord restent inchangés.
model LigneFacture {
  id          String   @id @default(uuid())
  factureId   String   @map("facture_id")
  designation String
  montantHt   Decimal  @map("montant_ht") @db.Decimal(14, 0)
  // Refacturation d'une étude (ET) : montant HT facturé par le bureau ;
  // montantHt = base × 1,10 (coordination, catalogue ET). Figé à la création.
  montantBase Decimal? @map("montant_base") @db.Decimal(14, 0)
  blocEtudeId String?  @map("bloc_etude_id")
  ordre       Int      @default(0)

  facture   Facture    @relation(fields: [factureId], references: [id], onDelete: Cascade)
  blocEtude BlocEtude? @relation(fields: [blocEtudeId], references: [id], onDelete: SetNull)

  @@index([factureId])
  @@index([blocEtudeId])
  @@map("lignes_facture")
}

// Comme SituationPaiement pend du Lot : Paiement pend de la Facture. Plusieurs
// paiements s'accumulent jusqu'à couverture du TTC ; le statut « payée » se
// déduit du cumul (jamais stocké). Suppression autorisée (correction) — c'est
// la Facture qui est immuable, pas ses paiements.
model Paiement {
  id           String        @id @default(uuid())
  factureId    String        @map("facture_id")
  date         String // AAAA-MM-JJ — date du versement
  montant      Decimal       @db.Decimal(14, 0)
  mode         ModePaiement?
  reference    String        @default("") // n° de virement / chèque, optionnel
  creeLe       DateTime      @default(now()) @map("cree_le") // ordre d'affichage
  // Ordre réel de l'événement dans le journal d'audit, posé par la base
  // (séquence commune, migration 20261026090000_ordre_journal).
  ordreJournal BigInt?       @map("ordre_journal")
  creeParId    String?       @map("cree_par_id") // audit, pas de FK

  facture Facture @relation(fields: [factureId], references: [id], onDelete: Cascade)

  @@index([factureId])
  @@map("paiements")
}

// --- Contrôle interne (revue CFO validée 20/10/2026) ---------------------------
// Tout avoir part d'une demande : motif obligatoire, CEO prévenu ; au-delà du
// seuil (Réglages · seuil_validation_avoir_ceo, TTC), le CEO valide avant
// émission — la facture n'est annulée qu'à ce moment. En deçà, la demande
// naît validée et l'avoir est émis aussitôt.
enum MotifAvoir {
  erreur_facturation
  remise_commerciale
  litige_client
  annulation_prestation
  autre
}

enum StatutDemandeAvoir {
  a_valider
  valide
  refuse
}

model DemandeAvoir {
  id            String             @id @default(uuid())
  societeId     String             @map("societe_id")
  factureId     String             @map("facture_id") // facture à annuler
  motif         MotifAvoir
  commentaire   String
  montantTtc    Decimal            @map("montant_ttc") @db.Decimal(14, 0) // figé à la demande
  statut        StatutDemandeAvoir @default(a_valider)
  demandeParId  String?            @map("demande_par_id") // audit, pas de FK
  demandeLe     DateTime           @default(now()) @map("demande_le")
  // Ordre réel de l'événement dans le journal d'audit, posé par la base
  // (séquence commune, migration 20261026090000_ordre_journal).
  ordreDemande  BigInt?            @map("ordre_demande")
  decideParId   String?            @map("decide_par_id") // null + validé = sous le seuil
  decideLe      DateTime?          @map("decide_le")
  // Ordre réel de l'événement dans le journal d'audit, posé par la base
  // (séquence commune, migration 20261026090000_ordre_journal).
  ordreDecision BigInt?            @map("ordre_decision")
  motifRefus    String             @default("") @map("motif_refus")
  avoirId       String?            @map("avoir_id") // avoir émis (pas de FK)

  facture Facture @relation(fields: [factureId], references: [id], onDelete: Cascade)

  @@index([societeId, statut])
  @@index([factureId])
  @@map("demandes_avoir")
}

// Clôture mensuelle : un mois clos n'accepte plus aucun paiement daté de ce
// mois (ajout, suppression) ; toute correction passe par un avoir ou une
// écriture du mois en cours. Journal d'événements : le mois est clos si son
// dernier événement est une clôture ; la réouverture est réservée au CEO.
enum ActionCloture {
  cloture
  reouverture
}

model JournalCloture {
  id           String        @id @default(uuid())
  societeId    String        @map("societe_id")
  mois         String // AAAA-MM
  action       ActionCloture
  motif        String        @default("") // obligatoire à la réouverture
  parId        String?       @map("par_id") // audit, pas de FK
  createdAt    DateTime      @default(now()) @map("created_at")
  // Ordre réel de l'événement dans le journal d'audit, posé par la base
  // (séquence commune, migration 20261026090000_ordre_journal).
  ordreJournal BigInt?       @map("ordre_journal")

  @@index([societeId, mois])
  @@map("journal_clotures")
}

// Rentabilité par projet, phase 1 (lot 7, décisions du 21/10/2026) :
// paramètres de calcul versionnés, modifiables par le CFO seul. Une valeur
// s'applique à partir de sa date d'effet (le 1er d'un mois, jamais un mois
// passé) : un changement ne réécrit pas les mois déjà calculés. Sans ligne,
// la valeur par défaut du code (finances/rentabilite/regles-rentabilite.ts).
model ParametreRentabilite {
  id           String   @id @default(uuid())
  societeId    String   @map("societe_id")
  cle          String // heures_reference | coefficient_charges | marge_cible
  valeur       Float? // null = désactivé / vide
  dateEffet    String   @map("date_effet") // AAAA-MM-01
  motif        String
  parId        String?  @map("par_id") // audit, pas de FK
  createdAt    DateTime @default(now()) @map("created_at")
  // Ordre réel de l'événement dans le journal d'audit, posé par la base
  // (séquence commune, migration 20261026090000_ordre_journal).
  ordreJournal BigInt?  @map("ordre_journal")

  @@index([societeId, cle])
  @@map("parametres_rentabilite")
}

// Numérotation des factures (lot 6, à la manière de Zervant) : chaque
// réglage du CFO est une ligne (les préfixes déjà utilisés restent visibles
// et resélectionnables) ; le format en vigueur est la dernière. Sans ligne :
// initiales de la société, année sur 4 chiffres, « - », 4 chiffres, départ 1.
// Verrou d'émission des factures (ADR 0003) : une ligne par société et par
// année civile, mise à jour en tête de chaque transaction d'émission. Le
// verrou de ligne ainsi pris sérialise les émissions d'une même société ; le
// numéro légal reste dérivé des factures émises (plus grand + 1).
model VerrouNumerotation {
  id                 String   @id @default(uuid())
  societeId          String   @map("societe_id")
  annee              Int
  derniereEmissionLe DateTime @default(now()) @map("derniere_emission_le")

  societe Societe @relation(fields: [societeId], references: [id], onDelete: Cascade)

  @@unique([societeId, annee])
  @@map("verrous_numerotation")
}

model NumerotationFactures {
  id           String   @id @default(uuid())
  societeId    String   @map("societe_id")
  prefixe      String // « GC », « TEST »… (vide permis)
  formatAnnee  String   @map("format_annee") // AAAA | AA
  separateur   String
  chiffres     Int
  numeroDepart Int      @map("numero_depart")
  motif        String
  parId        String?  @map("par_id") // audit, pas de FK
  createdAt    DateTime @default(now()) @map("created_at")
  // Ordre réel de l'événement dans le journal d'audit, posé par la base
  // (séquence commune, migration 20261026090000_ordre_journal).
  ordreJournal BigInt?  @map("ordre_journal")

  @@index([societeId, createdAt])
  @@map("numerotation_factures")
}

enum AnnexeCgv {
  premiere_facture
  toujours
  jamais
}

// Commission d'apporteur (revue COO, 22/10/2026). Par défaut : % des
// honoraires HT encaissés, due à chaque encaissement au prorata ; autre
// mode : % des honoraires HT du contrat signé, due à la signature.
enum ModeCommission {
  encaisse_prorata
  signature_contrat
}

enum StatutCommission {
  a_payer
  payee
}

// Une ligne par fait générateur : un encaissement d'honoraires (cle
// « paiement:<id> ») ou la signature (cle « signature:<dossier> »). Calculée
// par le HUB, idempotente ; le COO suit, le CFO paie.
model CommissionApporteur {
  id           String           @id @default(uuid())
  societeId    String           @map("societe_id")
  dossierCrmId String           @map("dossier_crm_id")
  cle          String
  paiementId   String?          @map("paiement_id") // pas de FK : un encaissement supprimé laisse la trace
  baseHt       Decimal          @map("base_ht") @db.Decimal(14, 0)
  taux         Decimal          @db.Decimal(3, 1)
  montant      Decimal          @db.Decimal(14, 0)
  exigibleLe   String           @map("exigible_le") // AAAA-MM-JJ
  statut       StatutCommission @default(a_payer)
  payeeLe      String?          @map("payee_le")
  payeeParId   String?          @map("payee_par_id")
  modePaiement ModePaiement?    @map("mode_paiement")
  reference    String           @default("")
  createdAt    DateTime         @default(now()) @map("created_at")

  dossier DossierCrm @relation(fields: [dossierCrmId], references: [id], onDelete: Cascade)

  @@unique([societeId, cle])
  @@index([dossierCrmId])
  @@map("commissions_apporteur")
}

// Coordonnées de paiement de l'apporteur d'un dossier — protégées comme
// celles de la société : versionnées, identité confirmée à chaque
// changement, CFO et CEO prévenus (revue COO, 22/10/2026).
model CoordonneesApporteur {
  id           String   @id @default(uuid())
  dossierCrmId String   @map("dossier_crm_id")
  banque       String   @default("")
  rib          String   @default("")
  wave         String   @default("")
  orangeMoney  String   @default("") @map("orange_money")
  confirmation String? // « code » ou « mot_de_passe »
  parId        String?  @map("par_id")
  createdAt    DateTime @default(now()) @map("created_at")

  dossier DossierCrm @relation(fields: [dossierCrmId], references: [id], onDelete: Cascade)

  @@index([dossierCrmId, createdAt])
  @@map("coordonnees_apporteur")
}

// Profil de facturation de la société (lot 6) : ce qu'imprime la facture
// (identité, NINEA, RCCM, contact, règlement, pied). Versionné comme la
// numérotation : la dernière ligne fait foi, les autres tracent les changements.
model ProfilFacturation {
  id                 String         @id @default(uuid())
  societeId          String         @map("societe_id")
  raisonSociale      String         @map("raison_sociale")
  adresse            String         @default("")
  ninea              String         @default("")
  rccm               String         @default("")
  cofi               String         @default("") // code fiscal imprimé après le NINEA (« COFI 292 » dans les CGV)
  capital            String         @default("") // « 1 000 000 FCFA »
  telephone          String         @default("")
  email              String         @default("")
  banque             String         @default("")
  rib                String         @default("") // RIB ou IBAN
  wave               String         @default("")
  orangeMoney        String         @default("") @map("orange_money")
  conditionsPaiement String         @default("") @map("conditions_paiement")
  mentionsPied       String         @default("") @map("mentions_pied")
  // Logo pour les documents (SVG ou PNG transparent, data URI) ; null = logo
  // de la société.
  logoDocument       String?        @map("logo_document")
  // CGV complètes en annexe : sur la 1re facture du projet par défaut (les
  // suivantes citent les articles clés), sur toutes, ou jamais.
  cgvAnnexe          AnnexeCgv      @default(premiere_facture) @map("cgv_annexe")
  // Commissions des apporteurs (revue COO, 22/10/2026) : mode réglé par le
  // CFO, figé pour chaque dossier à la date de sa signature.
  modeCommission     ModeCommission @default(encaisse_prorata) @map("mode_commission")
  // Coordonnées de paiement changées dans cette version : identité confirmée
  // par « code » (double authentification) ou « mot_de_passe » ; null sinon.
  confirmation       String?
  parId              String?        @map("par_id")
  createdAt          DateTime       @default(now()) @map("created_at")
  // Ordre réel de l'événement dans le journal d'audit, posé par la base
  // (séquence commune, migration 20261026090000_ordre_journal).
  ordreJournal       BigInt?        @map("ordre_journal")

  @@index([societeId, createdAt])
  @@map("profils_facturation")
}

// Trace d'un paiement supprimé (correction) : copie figée de la ligne au
// moment de la suppression, + qui l'avait saisi et qui l'a supprimé. Hors
// de Paiement pour que les cumuls (statut « payée », tableaux de bord) ne
// voient jamais ces lignes. Pas de FK : la trace survit à tout.
model PaiementSupprime {
  id            String        @id @default(uuid())
  paiementId    String        @map("paiement_id")
  factureId     String        @map("facture_id")
  societeId     String        @map("societe_id")
  date          String
  montant       Decimal       @db.Decimal(14, 0)
  mode          ModePaiement?
  reference     String        @default("")
  creeLe        DateTime      @map("cree_le")
  creeParId     String?       @map("cree_par_id")
  supprimeLe    DateTime      @default(now()) @map("supprime_le")
  // Ordre réel de l'événement dans le journal d'audit, posé par la base
  // (séquence commune, migration 20261026090000_ordre_journal).
  ordreJournal  BigInt?       @map("ordre_journal")
  supprimeParId String        @map("supprime_par_id")
  motif         String        @default("") // obligatoire depuis le 14/10/2026 ("" = trace antérieure)

  @@index([factureId])
  @@map("paiements_supprimes")
}

// =============================================================================
// Devis (brique « gestion », 2ᵉ étage après Facturation) — cf. cadrage « Devis ».
// Miroir partiel de Facture (numérotation séquentielle par société, dates
// agenda en String, horodatages en DateTime) — diffère sur trois points figés
// au cadrage :
//   · un Devis a de VRAIES lignes multiples (LigneDevis, taux de TVA propre à
//     chaque ligne) — Facture reste à montant unique (échéancier à 3 jalons) :
//     montantHt/montantTva du devis sont dérivés à la lecture en sommant les
//     lignes (une seule source, jamais stockés en double) ;
//   · conversion en facture = additionne les lignes en un montantHt unique
//     sur la Facture créée (jalon = null), jamais une refonte de Facture pour
//     lui ajouter des lignes (système déjà livré et testé, cf. mémoire) —
//     Facture.devisOrigineId porte la traçabilité vers le détail ligne par
//     ligne, jamais dupliqué ;
//   · projetId nullable : un devis peut précéder la création du dossier
//     projet (devis « libre ») — Facture.projetId est nullable pour la même
//     raison (la conversion doit aboutir même sans projet) ;
//   · double canal de réponse dès le départ : validation manuelle par l'admin
//     (statut posé à la main) ET lien public sans compte (tokenPublicHash,
//     même convention qu'Invitation.tokenHash — seul le SHA-256 est stocké,
//     cf. auth/jetons.ts) — le client accepte/refuse sans compte, ou l'admin
//     tranche lui-même après une réponse reçue autrement.
// =============================================================================

// `expire` n'est PAS une valeur stockée : comme en_retard/payee pour Facture
// (statutFactureEffectif), c'est un statut dérivé à la lecture (envoye + date
// de validité dépassée sans réponse) — jamais une transition écrite en base.
// Cf. domaine.ts::statutDevisEffectif.
enum StatutDevis {
  brouillon
  envoye
  accepte
  refuse
  transforme // converti en facture — état terminal, comme `annulee` pour Facture
}

model Devis {
  id                  String      @id @default(uuid())
  societeId           String      @map("societe_id")
  projetId            String?     @map("projet_id") // nullable — devis « libre » possible
  clientId            String      @map("client_id") // toujours un client du CRM, jamais ressaisi
  numero              Int? // rang séquentiel par société — null tant que brouillon, comme Facture
  statut              StatutDevis @default(brouillon)
  objet               String      @default("")
  dateValidite        String?     @map("date_validite") // AAAA-MM-JJ (date agenda)
  dateEnvoi           DateTime?   @map("date_envoi")
  dateReponse         DateTime?   @map("date_reponse")
  // Jeton d'acceptation/refus sans compte — même convention QUE
  // Invitation.tokenHash (cf. auth/jetons.ts) : on ne stocke QUE le SHA-256,
  // jamais le jeton en clair (une fuite de base ne permet aucun rejeu). Le
  // clair ne vit que dans le lien envoyé par email, généré à l'envoi et
  // jamais ré-exposé ensuite — un renvoi régénère un nouveau jeton.
  tokenPublicHash     String?     @unique @map("token_public_hash")
  creeLe              DateTime    @default(now()) @map("cree_le")
  // Offre d'un dossier CRM (étape F) : préparée en « Nouveau projet »,
  // envoyée UNIQUEMENT par la validation DAF (cycle du dossier), validité
  // 7 jours. null = devis hors CRM (Facturation). Rattachée au projet
  // (projetId) au passage du dossier à « onboard ».
  dossierCrmId        String?     @map("dossier_crm_id")
  // Référence d'une offre de dossier (maquette Finances, oct. 2026) : code du
  // dossier + « OF » + rang de l'offre dans ce dossier (« KSN_DIA.26-OF1 »),
  // attribués à la création. null = devis libre : référence DEV-AAAA-NNNN.
  codeDossier         String?     @map("code_dossier")
  rangDossier         Int?        @map("rang_dossier")
  // Relances manuelles (J+3, J+6 — « relance à faire » dérivé à la lecture,
  // aucun scheduler) : compteur pour savoir laquelle est due.
  relancesEnvoyees    Int         @default(0) @map("relances_envoyees")
  // Parts F1 / F2 / F3 (%) figées à la soumission du dossier à la DAF
  // (Réglages · Règles et délais) : une offre déjà soumise garde ses parts,
  // même si le réglage change ensuite. null = jamais soumise (réglage courant).
  partsFactures       Json?       @map("parts_factures")
  // Message d'introduction du document ; null = texte généré depuis la fiche
  // du lead et les lignes (maquette Finances), tant que personne ne l'a réécrit.
  messageIntroduction String?     @map("message_introduction")
  // Délais prévisionnels de l'échéancier, en jours après la signature, par
  // échéance (clé de facturation-offre.ts) — saisis sur le brouillon, figés ensuite.
  delaisEcheancier    Json?       @map("delais_echeancier")
  derniereRelanceLe   DateTime?   @map("derniere_relance_le")
  // Remise sur toute l'offre (09/11/2026) : 5, 10, 15, 20 ou 25 % du HT de
  // chaque ligne, avant TVA ; null = aucune. Saisie sur le brouillon, figée
  // ensuite ; l'échéancier et les factures de l'Onboard suivent le remisé.
  remisePct           Int?        @map("remise_pct")

  societe            Societe       @relation(fields: [societeId], references: [id], onDelete: Cascade)
  projet             Projet?       @relation(fields: [projetId], references: [id], onDelete: SetNull)
  dossierCrm         DossierCrm?   @relation(fields: [dossierCrmId], references: [id], onDelete: SetNull)
  client             Client        @relation(fields: [clientId], references: [id])
  lignes             LigneDevis[]
  factureConvertie   Facture?      @relation("DevisConversion")
  facturesEcheancier Facture[]     @relation("DevisEcheancier")
  contrats           Contrat[]
  tachesTs           TacheProjet[] // éléments TS facturés par cet avenant

  @@unique([societeId, numero])
  @@unique([societeId, codeDossier, rangDossier])
  @@index([projetId])
  @@index([clientId])
  @@index([dossierCrmId])
  @@map("devis")
}

model LigneDevis {
  id               String  @id @default(uuid())
  devisId          String  @map("devis_id")
  produitServiceId String? @map("produit_service_id") // null = ligne libre
  designation      String
  // Ligne CO (tarif × surface × planches) : paramètres conservés pour
  // l'affichage (« 250 m² × 2 planches ») ; quantite = surface × planches,
  // donc tous les calculs aval (HT, TVA, conversion en facture) restent
  // « quantité × prix unitaire ».
  surfaceM2        Int?    @map("surface_m2")
  planches         Int?
  quantite         Decimal @default(1) @db.Decimal(10, 2)
  prixUnitaire     Decimal @map("prix_unitaire") @db.Decimal(14, 0)
  tauxTva          Decimal @default(18) @map("taux_tva") @db.Decimal(5, 2)
  ordre            Int     @default(0)

  devis          Devis           @relation(fields: [devisId], references: [id], onDelete: Cascade)
  produitService ProduitService? @relation(fields: [produitServiceId], references: [id], onDelete: SetNull)
  mensualites    Facture[] // SU / EX : une facture par mois facturé (étape H2)

  @@index([devisId])
  @@map("lignes_devis")
}

// Catalogue optionnel — démarre vide, l'admin l'alimente au fil de l'eau (pas
// de pré-remplissage : les libellés doivent être ceux du boss, pas une
// supposition métier, cf. mémoire). Sur chaque ligne de devis, piocher dans le
// catalogue reste une option À CÔTÉ de la ligne libre, jamais une contrainte.
// Mode de calcul d'une ligne tirée du catalogue (catalogue réel Grey
// Concrete, sept. 2026 — cf. prisma/data/catalogue-grey-concrete.json).
enum ModeCalculProduit {
  quantite // prix × quantité (pièces, mois…) — IM, SU, EX
  surface_planches // tarif × surface à concevoir × planches — CO
  forfait // montant saisi (prix modifiable) — PC (DPC/SPC)
  // TS-MAJ (reprise majeure) : tarif de la catégorie CO DU PROJET × surface
  // concernée × planches concernées (CGV art. 8) — pas de prix au catalogue.
  tarif_co_surface_planches
}

model ProduitService {
  id             String            @id @default(uuid())
  societeId      String            @map("societe_id")
  // Identité catalogue réel (null = produit ajouté à la main par l'admin,
  // sans règle de calcul). code unique par société : CO1, IM2, SU3, DPC…
  code           String?
  famille        String? // CO, IM, SU, EX, PC
  unite          String? // m2, piece, mois, forfait
  modeCalcul     ModeCalculProduit @default(quantite) @map("mode_calcul")
  // false : le prix du catalogue s'impose sur la ligne (jamais saisi).
  prixModifiable Boolean           @default(true) @map("prix_modifiable")
  // SU : catégorie CO dont il découle (CO1→SU1…) — jamais choisi librement.
  coAssocie      String?           @map("co_associe")
  designation    String
  prixUnitaire   Decimal?          @map("prix_unitaire") @db.Decimal(14, 0) // nullable — certains prix varient trop pour être fixés
  tauxTva        Decimal           @default(18) @map("taux_tva") @db.Decimal(5, 2)
  description    String            @default("")
  supprime       Boolean           @default(false)
  supprimeLe     DateTime?         @map("supprime_le")
  createdAt      DateTime          @default(now()) @map("created_at")

  societe Societe      @relation(fields: [societeId], references: [id], onDelete: Cascade)
  lignes  LigneDevis[]

  @@unique([societeId, code])
  @@index([societeId, supprime])
  @@map("produits_services")
}

// --- RH · Dossiers du personnel (lot 1, sept. 2026) --------------------------
// Dossier RH d'une personne, sur tout le groupe (Holding, Concrete, Coded).
// Distinct de Collaborateur (fiche d'équipe d'exécution) et d'Utilisateur
// (compte de connexion) : un salarié peut n'avoir ni l'un ni l'autre. Données
// sensibles (identité, paie, salaire) — lues/écrites seulement via le module
// « rh » de la matrice. Jamais supprimé : archivé au départ.
enum TypeContrat {
  cdi
  cdd
  stage
}

enum SituationFamiliale {
  celibataire
  marie
  divorce
  veuf
}

enum ModePaiementSalaire {
  virement
  wave
  orange_money
}

enum TypePieceDossier {
  piece_identite
  cv
  diplomes
  contrat_signe
  fiche_poste
  rib_ou_attestation
  certificat_residence
  photo_identite
  carte_ipm
}

model DossierPersonnel {
  id                         String               @id @default(uuid())
  matricule                  String               @unique // GH-0001, séquence groupe
  societeId                  String               @map("societe_id")
  collaborateurId            String?              @unique @map("collaborateur_id")
  // Compte HUB du salarié sans fiche d'équipe (direction, salariés hors
  // cellule) — lot 5 « Mon espace ». Un dossier relié à une fiche d'équipe
  // prend le compte de la fiche : les deux liens sont exclusifs (vérifié en
  // service, cf. rh/mon-compte.ts).
  utilisateurId              String?              @unique @map("utilisateur_id")
  poste                      String               @default("")
  typeContrat                TypeContrat          @default(cdi) @map("type_contrat")
  dateEntree                 String?              @map("date_entree") // AAAA-MM-JJ
  dateFin                    String?              @map("date_fin") // CDD, stage
  // Échéances légales (revue RH 20/10/2026) : alertes dans « À traiter » —
  // délais dans Réglages (alerte_fin_essai_jours, alerte_echeance_rh_jours).
  finEssai                   String?              @map("fin_essai") // AAAA-MM-JJ
  visiteMedicale             String?              @map("visite_medicale") // prochaine visite
  expirationPiece            String?              @map("expiration_piece") // CNI ou passeport
  prenom                     String               @default("")
  nom                        String               @default("")
  dateNaissance              String?              @map("date_naissance")
  lieuNaissance              String               @default("") @map("lieu_naissance")
  nationalite                String               @default("Sénégalaise")
  numeroPiece                String               @default("") @map("numero_piece") // CNI ou passeport
  telephone                  String               @default("")
  emailPro                   String               @default("") @map("email_pro")
  contactUrgence             String               @default("") @map("contact_urgence")
  // Saisis par le salarié dans « Mon espace › Mes informations » (maquette du
  // boss), enregistrés immédiatement.
  telephoneUrgence           String               @default("") @map("telephone_urgence")
  emailPerso                 String               @default("") @map("email_perso")
  situationFamiliale         SituationFamiliale?  @map("situation_familiale")
  enfantsACharge             Int                  @default(0) @map("enfants_a_charge")
  adresse                    String               @default("")
  modePaiement               ModePaiementSalaire  @default(virement) @map("mode_paiement")
  coordonneesPaiement        String               @default("") @map("coordonnees_paiement") // RIB ou numéro
  // Changement de moyen de paiement demandé par le salarié, validé par la RH
  // avant la paie (maquette). null = rien en attente.
  paiementDemandeMode        ModePaiementSalaire? @map("paiement_demande_mode")
  paiementDemandeCoordonnees String?              @map("paiement_demande_coordonnees")
  paiementDemandeLe          DateTime?            @map("paiement_demande_le")
  numeroIpm                  String               @default("") @map("numero_ipm")
  missionResultat            String               @default("") @map("mission_resultat")
  missionLivrables           String               @default("") @map("mission_livrables")
  missionKpi                 String               @default("") @map("mission_kpi")
  missionSignalAlerte        String               @default("") @map("mission_signal_alerte")
  archiveLe                  DateTime?            @map("archive_le")
  // Ordre réel de l'événement dans le journal d'audit, posé par la base
  // (séquence commune, migration 20261026090000_ordre_journal).
  ordreArchivage             BigInt?              @map("ordre_archivage")
  archiveParId               String?              @map("archive_par_id") // audit, pas de FK
  // Intégration (lot 3) : fin du suivi J30/J60/J90 — cf. rh/regles-integration.ts.
  confirmeLe                 String?              @map("confirme_le") // AAAA-MM-JJ
  confirmeParId              String?              @map("confirme_par_id") // audit, pas de FK
  creeParId                  String?              @map("cree_par_id")
  createdAt                  DateTime             @default(now()) @map("created_at")
  updatedAt                  DateTime             @updatedAt @map("updated_at")

  societe           Societe                 @relation(fields: [societeId], references: [id], onDelete: Restrict)
  collaborateur     Collaborateur?          @relation(fields: [collaborateurId], references: [id], onDelete: SetNull)
  utilisateur       Utilisateur?            @relation(fields: [utilisateurId], references: [id], onDelete: SetNull)
  pieces            PieceDossierPersonnel[]
  absences          DemandeAbsence[]
  remboursements    DemandeRemboursement[]
  attestations      DemandeAttestation[]
  pointsIntegration PointIntegration[]
  journalPaie       JournalPaie[]
  controlesTemps    ControleFeuilleTemps[]
  ecartsTemps       EcartFeuilleTemps[]
  bulletins         BulletinPaie[]
  salaires          ChangementSalaire[]

  @@index([societeId])
  @@map("dossiers_personnel")
}

model PieceDossierPersonnel {
  id          String           @id @default(uuid())
  dossierId   String           @map("dossier_id")
  type        TypePieceDossier
  nom         String
  cle         String // data URI (puis clé S3, même seam que FichierProjet)
  ajouteParId String?          @map("ajoute_par_id")
  createdAt   DateTime         @default(now()) @map("created_at")

  dossier DossierPersonnel @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@unique([dossierId, type]) // une pièce par type, remplaçable
  @@map("pieces_dossier_personnel")
}

// --- RH · Demandes (lot 2, sept. 2026) ----------------------------------------
// HYPOTHÈSES DE TRAVAIL (conception d'origine, non confirmées par un vrai RH) :
// circuit N+1 → validation RH ; solde 2 jours ouvrables/mois (dimanches exclus,
// fériés pas encore déduits) ; remboursements sans AUCUNE donnée médicale.
enum TypeAbsence {
  conge_paye
  maladie
  permission_exceptionnelle
  autre
}

enum StatutAbsence {
  attente_n1
  autres_dates // le N+1 propose d'autres dates : le salarié accepte ou retire
  accord_n1 // en attente de la validation finale RH
  validee
  refusee
  retiree
}

enum DecisionN1 {
  valider
  sous_conditions
  autres_dates
  refuser
}

enum MotifRefusAbsence {
  periode_critique
  effectif_insuffisant
  solde_insuffisant
  autre
}

model DemandeAbsence {
  id                  String             @id @default(uuid())
  dossierId           String             @map("dossier_id")
  type                TypeAbsence
  dateDebut           String             @map("date_debut") // AAAA-MM-JJ
  dateFin             String             @map("date_fin")
  jours               Int // jours ouvrables (lundi → samedi)
  commentaire         String             @default("")
  justificatifNom     String?            @map("justificatif_nom")
  justificatifCle     String?            @map("justificatif_cle") // data URI
  statut              StatutAbsence      @default(attente_n1)
  // N+1 figé au dépôt : chef de cellule (fiche) OU rôle de direction.
  n1CollaborateurId   String?            @map("n1_collaborateur_id")
  n1Role              String?            @map("n1_role")
  decisionN1          DecisionN1?        @map("decision_n1")
  decisionN1ParId     String?            @map("decision_n1_par_id")
  decisionN1Le        DateTime?          @map("decision_n1_le")
  motifRefus          MotifRefusAbsence? @map("motif_refus")
  commentaireRefus    String             @default("") @map("commentaire_refus")
  datesProposeesDebut String?            @map("dates_proposees_debut")
  datesProposeesFin   String?            @map("dates_proposees_fin")
  traitementLivrables Json?              @map("traitement_livrables") // délégations / reports décidés
  valideRhParId       String?            @map("valide_rh_par_id")
  valideRhLe          DateTime?          @map("valide_rh_le")
  // Dir. GC (revue du 21/10/2026) : qui tient sa place pendant l'absence
  // validée — un autre Dir. GC ou le CTO (compte) ; null = le CTO.
  suppleantId         String?            @map("suppleant_id")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  dossier DossierPersonnel @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@index([dossierId])
  @@index([statut])
  @@map("demandes_absence")
}

enum CategorieSoins {
  pharmacie
  consultation
  analyses_imagerie
  hospitalisation
  dentaire_optique
  autre
}

enum BeneficiaireSoins {
  moi
  conjoint
  enfant
}

enum StatutRemboursement {
  soumise
  transmise
  remboursee
  rejetee
}

// Aucun diagnostic : seulement la catégorie de dépense, le bénéficiaire, la
// date, le montant et les justificatifs (circuit administratif).
// Attestation de travail sur demande (maquette « Mon espace › Mes
// documents ») : le salarié la demande, la RH la délivre en déposant le
// document signé ; il la télécharge ensuite.
model DemandeAttestation {
  id            String    @id @default(uuid())
  dossierId     String    @map("dossier_id")
  demandeLe     DateTime  @default(now()) @map("demande_le")
  delivreeLe    DateTime? @map("delivree_le")
  delivreeParId String?   @map("delivree_par_id") // audit, pas de FK
  nom           String?
  cle           String? // data URI (seam S3, comme les autres pièces)

  dossier DossierPersonnel @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@index([dossierId])
  @@map("demandes_attestation")
}

model DemandeRemboursement {
  id               String              @id @default(uuid())
  dossierId        String              @map("dossier_id")
  categorie        CategorieSoins
  beneficiaire     BeneficiaireSoins   @default(moi)
  dateSoins        String              @map("date_soins")
  montant          Int // FCFA
  montantRembourse Int?                @map("montant_rembourse")
  statut           StatutRemboursement @default(soumise)
  motifRejet       String              @default("") @map("motif_rejet")
  transmiseLe      DateTime?           @map("transmise_le")
  traiteLe         DateTime?           @map("traite_le")
  traiteParId      String?             @map("traite_par_id")
  createdAt        DateTime            @default(now()) @map("created_at")

  dossier       DossierPersonnel            @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  justificatifs JustificatifRemboursement[]

  @@index([dossierId])
  @@map("demandes_remboursement")
}

model JustificatifRemboursement {
  id        String   @id @default(uuid())
  demandeId String   @map("demande_id")
  nom       String
  cle       String // data URI
  createdAt DateTime @default(now()) @map("created_at")

  demande DemandeRemboursement @relation(fields: [demandeId], references: [id], onDelete: Cascade)

  @@map("justificatifs_remboursement")
}

// --- RH · Intégration des nouveaux arrivants (lot 3, sept. 2026) ------------
// Points à J+30, J+60, J+90 (jours calendaires depuis l'entrée), jusqu'à la
// confirmation. Contenu d'un point = compte rendu libre : les critères du
// manuel (§9.3) ne sont pas encore connus — ne rien inventer ici.
model PointIntegration {
  id              String   @id @default(uuid())
  dossierId       String   @map("dossier_id")
  jalon           Int // 30, 60 ou 90
  realiseLe       String   @map("realise_le") // AAAA-MM-JJ
  compteRendu     String   @map("compte_rendu")
  enregistreParId String?  @map("enregistre_par_id") // audit, pas de FK
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  dossier DossierPersonnel @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@unique([dossierId, jalon])
  @@map("points_integration")
}

// --- RH · Temps de travail (lot 4, sept. 2026) -------------------------------
// Une « tâche assignée » = un bloc de checklist Avant-projet / Permis /
// Exécution dont le collaborateur est responsable (l'assignation est par bloc,
// décision boss). Sa durée standard est fixée par la société (référentiel
// ci-dessous, vide par défaut : aucune valeur inventée) et se répartit sur la
// fenêtre début → échéance du bloc. Personne ne saisit ni ne modifie d'heures.
enum SectionTache {
  avant_projet
  permis
  execution
}

// Contrôle RH d'une feuille de mois clos : fige les chiffres et le détail du
// calcul tels qu'ils ont été contrôlés (une réassignation ou une durée
// modifiée ensuite ne réécrit pas un mois déjà contrôlé).
model ControleFeuilleTemps {
  id                String   @id @default(uuid())
  dossierId         String   @map("dossier_id")
  mois              String // AAAA-MM
  heuresImputees    Decimal  @map("heures_imputees") @db.Decimal(6, 1)
  heuresDisponibles Decimal  @map("heures_disponibles") @db.Decimal(6, 1)
  joursAbsence      Int      @map("jours_absence")
  detail            Json // lignes de calcul (tâches) au moment du contrôle
  controleLe        DateTime @default(now()) @map("controle_le")
  controleParId     String?  @map("controle_par_id") // audit, pas de FK

  dossier DossierPersonnel @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@unique([dossierId, mois])
  @@map("controles_feuilles_temps")
}

// Journal de la paie (revue RH 20/10/2026) : qui a consulté ou modifié le
// salaire ou un bulletin de qui, et quand — la donnée la plus sensible du
// HUB. JAMAIS de montant ici. Lu dans le journal d'audit (catégorie Paie).
enum ActionPaie {
  salaire_consulte
  salaire_modifie // changement validé (en vigueur à sa date d'effet)
  salaire_propose
  salaire_refuse
  cout_consulte // détail du coût d'un salarié sur un projet (rentabilité)
  bulletin_consulte
  bulletin_depose
  bulletin_retire
}

model JournalPaie {
  id           String     @id @default(uuid())
  dossierId    String     @map("dossier_id")
  action       ActionPaie
  mois         String? // bulletin concerné (AAAA-MM)
  parId        String?    @map("par_id") // audit, pas de FK
  createdAt    DateTime   @default(now()) @map("created_at")
  // Ordre réel de l'événement dans le journal d'audit, posé par la base
  // (séquence commune, migration 20261026090000_ordre_journal).
  ordreJournal BigInt?    @map("ordre_journal")

  dossier DossierPersonnel @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@index([dossierId, createdAt])
  @@index([createdAt])
  @@map("journal_paie")
}

// Historique des salaires (revue RH validée 20/10/2026) : chaque changement
// a une date d'effet et un motif obligatoire ; la RH le propose, le CFO le
// valide (le CEO pour le salaire du CFO), personne ne valide le sien. Le
// salaire en vigueur à une date = le dernier changement VALIDÉ dont la date
// d'effet est passée (cf. rh/regles-salaire.ts). JAMAIS de montant ailleurs.
enum MotifSalaire {
  embauche // salaire d'entrée (et reprise des salaires d'avant l'historique)
  augmentation
  promotion
  fin_essai
  correction
}

enum StatutSalaire {
  a_valider
  valide
  refuse
}

model ChangementSalaire {
  id           String        @id @default(uuid())
  dossierId    String        @map("dossier_id")
  montant      Int // FCFA, brut mensuel de base
  dateEffet    String?       @map("date_effet") // AAAA-MM-JJ ; null = reprise, date inconnue
  motif        MotifSalaire
  statut       StatutSalaire @default(a_valider)
  proposeParId String?       @map("propose_par_id") // audit, pas de FK
  proposeLe    DateTime      @default(now()) @map("propose_le")
  decideParId  String?       @map("decide_par_id") // audit, pas de FK
  decideLe     DateTime?     @map("decide_le")
  motifRefus   String        @default("") @map("motif_refus")

  dossier DossierPersonnel @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@index([dossierId, statut])
  @@map("changements_salaire")
}

// Écart signalé par le salarié sur sa feuille de temps calculée (revue
// Salarié 19/10/2026) : il ne la confirme pas — sans signalement, elle est
// juste. La RH corrige la source (absence, fenêtre de tâche) puis répond ;
// un écart ouvert bloque le contrôle du mois. Un seul ouvert par mois.
model EcartFeuilleTemps {
  id           String    @id @default(uuid())
  dossierId    String    @map("dossier_id")
  mois         String // AAAA-MM
  commentaire  String
  signaleLe    DateTime  @default(now()) @map("signale_le")
  signaleParId String?   @map("signale_par_id") // audit, pas de FK
  reponse      String?
  traiteLe     DateTime? @map("traite_le")
  traiteParId  String?   @map("traite_par_id") // audit, pas de FK

  dossier DossierPersonnel @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@index([dossierId, mois])
  @@map("ecarts_feuilles_temps")
}

// --- RH · Bulletins de paie (lot 5b, sept. 2026) -----------------------------
// Un bulletin par salarié et par mois, déposé par la RH (remplaçable pour une
// correction), visible par le salarié dans « Mon espace » · Mes documents.
model BulletinPaie {
  id          String   @id @default(uuid())
  dossierId   String   @map("dossier_id")
  mois        String // AAAA-MM
  nom         String
  cle         String // data URI (puis clé S3, même seam que PieceDossierPersonnel)
  deposeParId String?  @map("depose_par_id") // audit, pas de FK
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  dossier DossierPersonnel @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@unique([dossierId, mois])
  @@map("bulletins_paie")
}

// --- RH · Remise et validation des tâches (lot 5c, sept. 2026) ---------------
// Le responsable d'un bloc assigné le remet ; son N+1 (chef de cellule, sinon
// Dir. GC — même chaîne que les absences) le valide ou le renvoie avec un
// motif. Une ligne par bloc, commune aux trois sections (même clé que les
// tâches du module Temps : section + projet + groupe). Réassigner le bloc
// efface la ligne : le circuit repart de zéro avec le nouveau responsable.
model ValidationTache {
  section     SectionTache
  projetId    String       @map("projet_id")
  groupe      String
  remisLe     DateTime?    @map("remis_le")
  remisParId  String?      @map("remis_par_id") // audit, pas de FK
  valideLe    DateTime?    @map("valide_le")
  valideParId String?      @map("valide_par_id") // audit, pas de FK
  // Dernier renvoi (conservé après une nouvelle remise, pour mémoire).
  renvoyeLe   DateTime?    @map("renvoye_le")
  renvoiMotif String       @default("") @map("renvoi_motif")

  projet Projet @relation(fields: [projetId], references: [id], onDelete: Cascade)

  @@id([section, projetId, groupe])
  @@index([remisLe, valideLe])
  @@map("validations_taches")
}

// --- Réglages du HUB (CIO) — maquette du boss, sept. 2026 ----------------------
// Gabarit de projet versionné : un projet garde la version avec laquelle il a
// été ouvert. Le contenu (étapes → cartes → tâches, fenêtres en jours ouvrés
// depuis J1 et temps standard) est un instantané immuable, validé par le
// service (cf. src/reglages/gabarit.ts). Enregistrer une modification crée
// la version suivante ; les versions ne sont jamais modifiées ni supprimées.
model GabaritVersion {
  id        String   @id @default(uuid())
  societeId String   @map("societe_id")
  code      String // ex. GC-CONCEPTION
  numero    Int // 0 = bêta 1.0, 1 = bêta 1.1…
  libelle   String // « bêta 1.0 »
  contenu   Json
  motif     String   @default("")
  creeParId String?  @map("cree_par_id") // audit, pas de FK
  createdAt DateTime @default(now()) @map("created_at")

  societe Societe  @relation(fields: [societeId], references: [id], onDelete: Cascade)
  projets Projet[]

  @@unique([societeId, code, numero])
  @@map("gabarit_versions")
}

// Historique d'une tâche (panneau de la tâche, maquette « Projets ») : une
// ligne par fait — jamais modifiée ni supprimée.
enum TypeEvenementTache {
  assignation
  remise
  validation
  reprise
  prolongation // demande ou décision de prolongation
  visa // visa DPLG apposé ou refusé (revue Dir. GC, 21/10/2026)
  relance // l'assigné relance son validateur (3 jours ouvrés sans réponse)
}

model EvenementTacheProjet {
  id      String             @id @default(uuid())
  tacheId String             @map("tache_id")
  type    TypeEvenementTache
  parId   String?            @map("par_id")
  detail  String // phrase affichée (« Assignée à Moussa Diop »)
  creeLe  DateTime           @default(now()) @map("cree_le")

  tache TacheProjet  @relation(fields: [tacheId], references: [id], onDelete: Cascade)
  par   Utilisateur? @relation("EvenementTacheProjetPar", fields: [parId], references: [id], onDelete: SetNull)

  @@index([tacheId, creeLe])
  @@map("evenements_tache_projet")
}

// Fichiers joints à une remise (facultatifs : une visite ou une réunion n'en
// produit pas). Rattachés à la version remise (v01, v02…) — l'historique
// garde ceux de chaque reprise. Data URI tant que le stockage objet n'est pas
// branché (phase 2), comme les pièces du dossier RH.
model PieceRemiseTache {
  id          String   @id @default(uuid())
  tacheId     String   @map("tache_id")
  version     Int
  nom         String
  cle         String
  ajouteParId String?  @map("ajoute_par_id") // audit, pas de FK
  createdAt   DateTime @default(now()) @map("created_at")

  tache TacheProjet @relation(fields: [tacheId], references: [id], onDelete: Cascade)

  @@index([tacheId, version])
  @@map("pieces_remise_tache")
}

// Fil de discussion d'un projet ouvert (maquette « Projets ») : par carte
// (tacheId null) ou par tâche. Une @mention notifie la personne ; le
// commentaire reste ouvert jusqu'à une réponse ou sa résolution par l'auteur.
// Un seul niveau de réponse.
model CommentaireProjet {
  id           String    @id @default(uuid())
  projetId     String    @map("projet_id")
  carteId      String    @map("carte_id")
  tacheId      String?   @map("tache_id")
  parentId     String?   @map("parent_id") // réponse à ce commentaire
  auteurId     String?   @map("auteur_id")
  mentionneId  String?   @map("mentionne_id")
  // La personne mentionnée l'a traitée (lue, ou y a répondu) depuis « Mes
  // tâches » (revue Salarié 19/10/2026).
  mentionLueLe DateTime? @map("mention_lue_le")
  texte        String
  resoluLe     DateTime? @map("resolu_le")
  creeLe       DateTime  @default(now()) @map("cree_le")

  projet    Projet              @relation(fields: [projetId], references: [id], onDelete: Cascade)
  carte     CarteProjet         @relation(fields: [carteId], references: [id], onDelete: Cascade)
  tache     TacheProjet?        @relation(fields: [tacheId], references: [id], onDelete: Cascade)
  parent    CommentaireProjet?  @relation("ReponsesCommentaire", fields: [parentId], references: [id], onDelete: Cascade)
  reponses  CommentaireProjet[] @relation("ReponsesCommentaire")
  auteur    Utilisateur?        @relation("CommentaireProjetAuteur", fields: [auteurId], references: [id], onDelete: SetNull)
  mentionne Utilisateur?        @relation("CommentaireProjetMentionne", fields: [mentionneId], references: [id], onDelete: SetNull)

  @@index([carteId, creeLe])
  @@index([tacheId, creeLe])
  @@index([mentionneId, creeLe])
  @@map("commentaires_projet")
}

// Gabarit recopié dans un projet à son ouverture (maquette « Projets » du
// boss) : étapes → cartes → tâches, fenêtres en jours ouvrés depuis J1 et
// dates calendaires figées (jours fériés déduits). Une version du gabarit
// enregistrée ensuite ne touche plus ce projet.
model CarteProjet {
  id            String   @id @default(uuid())
  projetId      String   @map("projet_id")
  etapeNumero   Int      @map("etape_numero")
  etapeCle      String   @map("etape_cle")
  etapeLibelle  String   @map("etape_libelle")
  cle           String
  libelle       String
  ordre         Int
  note          String?
  descriptif    String?
  etiquette     String?
  debutJ        Int?     @map("debut_j")
  finJ          Int?     @map("fin_j")
  debutLe       String?  @map("debut_le") // AAAA-MM-JJ
  finLe         String?  @map("fin_le")
  temps         Json? // temps porté par la carte (par unité, au total)
  client        Boolean  @default(false) // CLIENT · hors budget atelier
  fichiers      Boolean  @default(false) // rubriques de fichiers, sans tâche
  // null = active ; sinon le motif affiché (« Désactivée · … »).
  desactivation String?
  ouvreApres    String[] @default([]) @map("ouvre_apres") // « carte.tâche »

  projet       Projet              @relation(fields: [projetId], references: [id], onDelete: Cascade)
  taches       TacheProjet[]
  commentaires CommentaireProjet[]
  blocsEtude   BlocEtude[]

  @@unique([projetId, cle])
  @@map("cartes_projet")
}

enum StatutTacheProjet {
  a_faire // pas encore remise : à venir / en cours / en retard selon les dates
  a_valider // remise vNN en attente de validation
  reprise // renvoyée, vNN+1 attendue
  validee
  non_necessaire
}

model TacheProjet {
  id                 String            @id @default(uuid())
  projetId           String            @map("projet_id")
  carteId            String            @map("carte_id")
  cle                String
  libelle            String
  ordre              Int
  descriptif         String?
  sourceNative       Boolean           @default(false) @map("source_native")
  debutJ             Int?              @map("debut_j") // fenêtre propre ; sinon celle de la carte
  finJ               Int?              @map("fin_j")
  debutLe            String?           @map("debut_le")
  finLe              String?           @map("fin_le") // échéance de référence (délai figé)
  temps              Json // copie du gabarit
  heures             Decimal?          @db.Decimal(6, 1) // temps standard résolu ; null = sans temps atelier
  statut             StatutTacheProjet @default(a_faire)
  motif              String? // raison de « Non nécessaire »
  assigneId          String?           @map("assigne_id")
  version            Int               @default(0) // dernière remise (1 = v01)
  valideeLe          DateTime?         @map("validee_le")
  valideeParId       String?           @map("validee_par_id")
  // Visa DPLG (revue Dir. GC, 21/10/2026) : la tâche, validée par le chef de
  // team, n'est faite qu'une fois visée par l'architecte DPLG (Dir. GC).
  // Repris du gabarit à l'ouverture du projet.
  visaRequis         Boolean           @default(false) @map("visa_requis")
  // Dépôt sans fichier refusé (case du gabarit, cochée par défaut — lot F,
  // 23/10/2026). Les tâches des projets ouverts avant la règle restent
  // facultatives (comme le visa : la version du gabarit est figée au projet).
  fichierObligatoire Boolean           @default(true) @map("fichier_obligatoire")
  visaLe             DateTime?         @map("visa_le")
  visaParId          String?           @map("visa_par_id")
  // Validée avant la règle du visa (21/10/2026) : ni bloquée ni réputée visée
  // — affichée « Visa non tracé (antérieur au 21/10/2026) ».
  visaNonTrace       Boolean           @default(false) @map("visa_non_trace")
  // Élément ajouté en TS : devis d'avenant qui le facture (ligne ajoutée à
  // l'ajout). Le devis n'est jamais recréé — seules ses lignes le sont.
  devisTsId          String?           @map("devis_ts_id")
  // Ligne ajoutée à ce projet par la direction (absente de sa version du
  // gabarit — personnalisation du 01/11/2026).
  ajouteeAuProjet    Boolean           @default(false) @map("ajoutee_au_projet")

  projet        Projet                 @relation(fields: [projetId], references: [id], onDelete: Cascade)
  devisTs       Devis?                 @relation(fields: [devisTsId], references: [id], onDelete: SetNull)
  carte         CarteProjet            @relation(fields: [carteId], references: [id], onDelete: Cascade)
  assigne       Collaborateur?         @relation("TacheProjetAssigne", fields: [assigneId], references: [id], onDelete: SetNull)
  valideePar    Utilisateur?           @relation("TacheProjetValideePar", fields: [valideeParId], references: [id], onDelete: SetNull)
  evenements    EvenementTacheProjet[]
  commentaires  CommentaireProjet[]
  prolongations ProlongationTache[]
  pieces        PieceRemiseTache[]

  @@unique([carteId, cle])
  @@index([projetId])
  @@index([assigneId])
  @@map("taches_projet")
}

// Règles et délais, objectifs des indicateurs : une ligne seulement pour une
// valeur modifiée — absente, c'est la valeur par défaut qui est en service
// (src/reglages/definitions.ts).
model ReglageSociete {
  societeId String   @map("societe_id")
  cle       String
  valeur    Json
  majParId  String?  @map("maj_par_id") // audit, pas de FK
  updatedAt DateTime @updatedAt @map("updated_at")

  societe Societe @relation(fields: [societeId], references: [id], onDelete: Cascade)

  @@id([societeId, cle])
  @@map("reglages_societe")
}

// Journal des réglages (ISO 9001 §7.5.3) : une ligne par valeur modifiée ;
// les lignes d'un même enregistrement partagent `lot` et le motif. Jamais
// modifié ni supprimé. Alimente aussi le registre des décisions (Pilotage).
model JournalReglage {
  id           String   @id @default(uuid())
  societeId    String   @map("societe_id")
  lot          String
  section      String // gabarit | regles | objectifs
  cle          String
  libelle      String // pré-rendu : « Livrables · Esquisses — temps : 40 h → 32 h »
  avant        Json?
  apres        Json?
  motif        String
  parId        String?  @map("par_id") // audit, pas de FK
  createdAt    DateTime @default(now()) @map("created_at")
  // Ordre réel de l'événement dans le journal d'audit, posé par la base
  // (séquence commune, migration 20261026090000_ordre_journal).
  ordreJournal BigInt?  @map("ordre_journal")

  societe Societe @relation(fields: [societeId], references: [id], onDelete: Cascade)

  @@index([societeId, createdAt])
  @@map("journal_reglages")
}

// Interventions de l'Administrateur HUB (carte blanche, 29/10/2026) : les
// déblocages qu'aucun rôle ne peut faire par le parcours normal, chacun avec
// son motif, au journal d'audit (catégorie « administration »).
enum TypeInterventionHub {
  onboard_sans_signature // dossier CRM passé en Onboard sans contrat signé
  ouverture_projet // projet ouvert selon le gabarit sans attendre l'émission de F1
  cellules_projet // cellules rattachées au projet (remplace l'ensemble)
  reouverture_dossier // dossier CRM perdu remis en « Nouveau projet »
  module_desactive // interrupteur : module coupé pour la société
  module_reactive // interrupteur : module rendu à la société
  maintenance_activee // HUB fermé à tous, sauf l'Administrateur HUB
  maintenance_levee // HUB rouvert
  suppression // dossier CRM et/ou projet supprimés définitivement, avec tout ce qui en dépend
}

model InterventionHub {
  id           String              @id @default(uuid())
  societeId    String              @map("societe_id")
  type         TypeInterventionHub
  cible        String // code du dossier ou du projet
  detail       String              @default("")
  motif        String
  parId        String?             @map("par_id") // audit, pas de FK
  createdAt    DateTime            @default(now()) @map("created_at")
  // Ordre réel de l'événement dans le journal d'audit, posé par la base
  // (séquence commune, migration 20261026090000_ordre_journal).
  ordreJournal BigInt?             @map("ordre_journal")

  societe Societe @relation(fields: [societeId], references: [id], onDelete: Cascade)

  @@index([societeId, createdAt])
  @@map("interventions_hub")
}

// Interrupteurs (Administrateur HUB, 29/10/2026) : un module de la matrice
// coupé pour une société. Tant que la ligne existe, le module vaut « aucun »
// pour tous ses comptes, quoi que dise la matrice (l'Administrateur HUB garde
// l'accès). Chaque bascule est une intervention au journal.
model ModuleDesactive {
  societeId String   @map("societe_id")
  moduleCle String   @map("module_cle")
  motif     String
  parId     String?  @map("par_id") // audit, pas de FK
  createdAt DateTime @default(now()) @map("created_at")

  societe Societe @relation(fields: [societeId], references: [id], onDelete: Cascade)

  @@id([societeId, moduleCle])
  @@map("modules_desactives")
}

// Mode maintenance du HUB entier (une seule ligne, id « hub ») : connexions
// et requêtes refusées, sauf pour l'Administrateur HUB ; le message est
// affiché à tous.
model MaintenanceHub {
  id        String   @id @default("hub")
  actif     Boolean  @default(false)
  message   String   @default("")
  parId     String?  @map("par_id") // audit, pas de FK
  modifieLe DateTime @updatedAt @map("modifie_le")

  @@map("maintenance_hub")
}

// Pilotage · tableau de bord Holding (maquettes du boss, oct. 2026).

enum TypeReporting {
  direction // Reporting {société} : Direction GC → CTO
  rh // Reporting RH : RH → CFO
}

// Reporting mensuel DÉPOSÉ (manuel §9.4) — une ligne au dépôt seulement ;
// avant, il est prérempli à la volée. `contenu` fige ce que l'émetteur a relu.
model ReportingMensuel {
  id          String        @id @default(uuid())
  societeId   String        @map("societe_id")
  type        TypeReporting
  mois        String // AAAA-MM
  deposeLe    DateTime      @default(now()) @map("depose_le")
  deposeParId String?       @map("depose_par_id") // audit, pas de FK
  contenu     Json?
  // Analyse rédigée par l'émetteur (lecture des chiffres, causes, actions),
  // obligatoire au dépôt et figée avec le contenu.
  analyse     String?

  societe   Societe             @relation(fields: [societeId], references: [id], onDelete: Cascade)
  lectures  LectureReporting[]
  questions QuestionReporting[]

  @@unique([societeId, type, mois])
  @@map("reportings_mensuels")
}

// Suivi d'un reporting déposé (revue CFO 20/10/2026, lot 5) : le destinataire
// accuse réception (une lecture par personne et par dépôt, la première fait
// foi) ou pose une question ; l'émetteur répond dans le même fil. Le dépôt
// est figé (aucun redépôt) : la lecture porte l'id du dépôt et sa date de
// dépôt (version lue), pour qu'un redépôt futur ne la rattache pas au neuf.
model LectureReporting {
  id           String   @id @default(uuid())
  reportingId  String   @map("reporting_id")
  lecteurId    String   @map("lecteur_id") // audit, pas de FK
  version      DateTime // deposeLe du dépôt lu
  luLe         DateTime @default(now()) @map("lu_le")
  // Ordre réel de l'événement dans le journal d'audit, posé par la base
  // (séquence commune, migration 20261026090000_ordre_journal).
  ordreJournal BigInt?  @map("ordre_journal")

  reporting ReportingMensuel @relation(fields: [reportingId], references: [id], onDelete: Cascade)

  @@unique([reportingId, lecteurId])
  @@map("lectures_reporting")
}

model QuestionReporting {
  id           String    @id @default(uuid())
  reportingId  String    @map("reporting_id")
  auteurId     String    @map("auteur_id") // audit, pas de FK
  texte        String
  creeLe       DateTime  @default(now()) @map("cree_le")
  // Ordre réel de l'événement dans le journal d'audit, posé par la base
  // (séquence commune, migration 20261026090000_ordre_journal).
  ordreJournal BigInt?   @map("ordre_journal")
  reponse      String?
  reponduParId String?   @map("repondu_par_id")
  reponduLe    DateTime? @map("repondu_le")
  // Ordre réel de l'événement dans le journal d'audit, posé par la base
  // (séquence commune, migration 20261026090000_ordre_journal).
  ordreReponse BigInt?   @map("ordre_reponse")

  reporting ReportingMensuel @relation(fields: [reportingId], references: [id], onDelete: Cascade)

  @@index([reportingId])
  @@map("questions_reporting")
}

enum OrigineDecision {
  saisie // décision d'une instance, saisie dans le HUB
  hub // inscrite par le HUB depuis l'événement qui la porte
}

// Registre des décisions (manuel §4.1) : décision, responsable, échéance.
// Numéro D-NNN séquentiel par société, jamais réutilisé. Une décision
// inscrite par le HUB a une `cleOrigine` (idempotence) et se clôt seule.
model DecisionRegistre {
  id                         String           @id @default(uuid())
  societeId                  String           @map("societe_id")
  numero                     Int
  date                       String // AAAA-MM-JJ
  instance                   String // « CODIR », « RH · congés », « Projets · AM_SL.26 »…
  origine                    OrigineDecision
  cleOrigine                 String?          @map("cle_origine")
  texte                      String
  responsable                String // libellé affiché
  responsableRole            String?          @map("responsable_role")
  responsableCollaborateurId String?          @map("responsable_collaborateur_id") // pas de FK : le libellé reste
  echeance                   String? // AAAA-MM-JJ
  // Rattachement facultatif (revue CTO, 21/10/2026) : visible sur la fiche
  // du projet, de la cellule ou du client.
  projetId                   String?          @map("projet_id")
  celluleId                  String?          @map("cellule_id")
  clientId                   String?          @map("client_id")
  closeLe                    DateTime?        @map("close_le")
  closeParId                 String?          @map("close_par_id")
  creeParId                  String?          @map("cree_par_id")
  // Décision proposée par le CTO ou le COO au CEO (revues CTO et COO, 22/10/2026) : null =
  // inscrite directement. Le CEO l'accepte (telle quelle ou modifiée) ou la
  // refuse, motif obligatoire ; la proposition d'origine reste tracée.
  proposition                EtatProposition?
  arbitreLe                  DateTime?        @map("arbitre_le")
  arbitreParId               String?          @map("arbitre_par_id")
  motifArbitrage             String?          @map("motif_arbitrage")
  proposeeInitiale           Json?            @map("proposee_initiale") // { texte, responsable, echeance } si modifiée
  createdAt                  DateTime         @default(now()) @map("created_at")

  societe Societe  @relation(fields: [societeId], references: [id], onDelete: Cascade)
  projet  Projet?  @relation(fields: [projetId], references: [id], onDelete: SetNull)
  cellule Cellule? @relation(fields: [celluleId], references: [id], onDelete: SetNull)
  client  Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@unique([societeId, numero])
  @@unique([societeId, cleOrigine])
  @@map("decisions_registre")
}

enum EtatProposition {
  proposee
  acceptee
  refusee
}

enum DecisionProlongation {
  accordee
  refusee
}

// Prolongation d'une tâche du gabarit (maquette « Projets », vue Salarié) :
// l'assigné demande (date + motif), le chef de team ou le DPLG décide.
// Choix du 06/10/2026 : l'échéance de référence reste figée — une
// prolongation accordée QUALIFIE le retard (la tâche n'est plus « en
// retard » jusqu'à `jusquau`), les indicateurs restent mesurés sur l'origine.
// TS au-delà du seuil (Réglages, 500 000 FCFA HT par défaut) : le Dir. GC le
// demande, le CTO le valide ; accepté, il devient la tâche TS et la ligne de
// l'avenant (comme un TS sous le seuil). Revue Dir. GC, 21/10/2026.
enum StatutDemandeTs {
  a_valider
  acceptee
  refusee
}

model DemandeTs {
  id           String          @id @default(uuid())
  societeId    String          @map("societe_id")
  projetId     String          @map("projet_id")
  carteId      String          @map("carte_id")
  element      String
  reprise      String // mineure | majeure
  surfaceM2    Int?            @map("surface_m2")
  planches     Int?
  montantHt    Decimal         @map("montant_ht") @db.Decimal(14, 0)
  statut       StatutDemandeTs @default(a_valider)
  demandeParId String?         @map("demande_par_id")
  demandeLe    DateTime        @default(now()) @map("demande_le")
  decideParId  String?         @map("decide_par_id")
  decideLe     DateTime?       @map("decide_le")
  motifRefus   String          @default("") @map("motif_refus")
  tacheId      String?         @map("tache_id") // tâche TS créée à l'acceptation

  projet Projet @relation(fields: [projetId], references: [id], onDelete: Cascade)

  @@index([societeId, statut])
  @@map("demandes_ts")
}

model ProlongationTache {
  id           String                @id @default(uuid())
  tacheId      String                @map("tache_id")
  jusquau      String // AAAA-MM-JJ demandé
  motif        String
  demandeLe    DateTime              @default(now()) @map("demande_le")
  demandeParId String?               @map("demande_par_id") // audit, pas de FK
  decision     DecisionProlongation?
  decideeLe    DateTime?             @map("decidee_le")
  decideeParId String?               @map("decidee_par_id")

  tache TacheProjet @relation(fields: [tacheId], references: [id], onDelete: Cascade)

  @@index([tacheId])
  @@map("prolongations_taches")
}

// Agenda (lot 11, 01/11/2026) : rendez-vous et réunions. Les échéances des
// tâches et les congés validés s'y ajoutent à la lecture (jamais copiés).
model RendezVous {
  id             String    @id @default(uuid())
  societeId      String    @map("societe_id")
  titre          String
  debut          DateTime
  fin            DateTime
  lieu           String?
  description    String?
  organisateurId String    @map("organisateur_id") // compte, sans clé (comme parId)
  annuleLe       DateTime? @map("annule_le")
  createdAt      DateTime  @default(now()) @map("created_at")

  societe Societe            @relation(fields: [societeId], references: [id], onDelete: Cascade)
  invites InviteRendezVous[]

  @@index([societeId, debut])
  @@map("rendez_vous")
}

model InviteRendezVous {
  rendezVousId  String @map("rendez_vous_id")
  utilisateurId String @map("utilisateur_id")

  rendezVous RendezVous @relation(fields: [rendezVousId], references: [id], onDelete: Cascade)

  @@id([rendezVousId, utilisateurId])
  @@index([utilisateurId])
  @@map("invites_rendez_vous")
}

// Abonnement à son agenda depuis Google Agenda, Apple Calendrier ou Outlook
// (12/11/2026) : un lien secret par personne et par société, relu par son
// agenda. Seule l'empreinte SHA-256 du jeton est gardée ; régénérer remplace
// l'empreinte, et l'ancien lien cesse de fonctionner.
model AbonnementAgenda {
  id             String    @id @default(uuid())
  societeId      String    @map("societe_id")
  utilisateurId  String    @map("utilisateur_id")
  jetonHash      String    @unique @map("jeton_hash")
  creeLe         DateTime  @default(now()) @map("cree_le")
  // Dernière relecture par l'agenda de la personne (au plus une écriture
  // toutes les 10 minutes) : lui montre que l'abonnement fonctionne.
  dernierAccesLe DateTime? @map("dernier_acces_le")

  societe     Societe     @relation(fields: [societeId], references: [id], onDelete: Cascade)
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@unique([societeId, utilisateurId])
  @@index([utilisateurId])
  @@map("abonnements_agenda")
}

// Annonces (lot 12, 01/11/2026) : à une société, à tout le groupe, ou à une
// équipe. Publication directe pour qui a la Validation de l'étape ; sinon,
// l'annonce attend d'être validée. « Importante » : accusé de lecture.
enum AudienceAnnonce {
  societe
  groupe
  equipe
}

enum StatutAnnonce {
  a_valider
  publiee
  retiree
}

model Annonce {
  id           String          @id @default(uuid())
  societeId    String          @map("societe_id") // société de l'auteur
  titre        String
  contenu      String
  audience     AudienceAnnonce
  celluleId    String?         @map("cellule_id") // audience « equipe »
  importante   Boolean         @default(false)
  statut       StatutAnnonce
  auteurId     String          @map("auteur_id") // compte, sans clé (comme parId)
  publieeLe    DateTime?       @map("publiee_le")
  valideeParId String?         @map("validee_par_id")
  retireeLe    DateTime?       @map("retiree_le")
  createdAt    DateTime        @default(now()) @map("created_at")

  societe  Societe          @relation(fields: [societeId], references: [id], onDelete: Cascade)
  lectures LectureAnnonce[]

  @@index([societeId, statut, publieeLe])
  @@index([audience, statut])
  @@map("annonces")
}

model LectureAnnonce {
  annonceId     String   @map("annonce_id")
  utilisateurId String   @map("utilisateur_id")
  luLe          DateTime @default(now()) @map("lu_le")

  annonce Annonce @relation(fields: [annonceId], references: [id], onDelete: Cascade)

  @@id([annonceId, utilisateurId])
  @@map("lectures_annonces")
}

// Recrutement (lot 13, décision du 01/11/2026) : Poste ouvert → Candidatures
// → Entretiens → Décision → Intégration RH (le dossier du personnel s'ouvre à
// l'embauche). Saisie manuelle des candidatures ; une candidature refusée est
// effacée 12 mois après le refus (données personnelles).
enum StatutPoste {
  a_approuver
  ouvert
  pourvu
  ferme
}

enum EtapeCandidature {
  candidature
  entretien
  embauche
  refusee
}

model PosteRecrutement {
  id            String      @id @default(uuid())
  societeId     String      @map("societe_id")
  intitule      String
  description   String?
  celluleId     String?     @map("cellule_id")
  statut        StatutPoste
  demandeParId  String      @map("demande_par_id")
  approuveParId String?     @map("approuve_par_id")
  approuveLe    DateTime?   @map("approuve_le")
  motifRefus    String?     @map("motif_refus")
  direct        Boolean     @default(false) // embauche directe : pourvu d'emblée
  createdAt     DateTime    @default(now()) @map("created_at")

  societe      Societe           @relation(fields: [societeId], references: [id], onDelete: Cascade)
  candidatures Candidature[]
  appel        AppelCandidature?

  @@index([societeId, statut])
  @@map("postes_recrutement")
}

model Candidature {
  id             String           @id @default(uuid())
  posteId        String           @map("poste_id")
  prenom         String
  nom            String
  email          String?
  telephone      String?
  notes          String           @default("")
  etape          EtapeCandidature @default(candidature)
  decideParId    String?          @map("decide_par_id")
  decideLe       DateTime?        @map("decide_le")
  motif          String?
  dossierId      String?          @map("dossier_id") // dossier du personnel ouvert à l'embauche
  rendezVousId   String?          @map("rendez_vous_id") // entretien : rendez-vous de l'Agenda
  source         String           @default("saisie") // saisie (RH) | lien (appel à candidatures)
  reponses       Json? // réponses aux questions de l'appel : { [questionId]: texte }
  consentementLe DateTime?        @map("consentement_le")
  creeParId      String           @map("cree_par_id")
  createdAt      DateTime         @default(now()) @map("created_at")

  poste  PosteRecrutement   @relation(fields: [posteId], references: [id], onDelete: Cascade)
  pieces PieceCandidature[]

  @@index([posteId, etape])
  @@index([etape, decideLe])
  @@map("candidatures")
}

// Appel à candidatures (01/11/2026) : la page publique d'un poste ouvert.
// `slug` est l'adresse publique (faite pour être partagée, pas un secret).
model AppelCandidature {
  id           String   @id @default(uuid())
  societeId    String   @map("societe_id")
  posteId      String   @unique @map("poste_id")
  slug         String   @unique
  presentation String // missions, profil recherché : texte public
  lieu         String?
  typeContrat  String?  @map("type_contrat")
  dateLimite   String?  @map("date_limite") // AAAA-MM-JJ, incluse
  pieces       Json     @default("[]") // [{ cle, libelle, obligatoire }] — le CV toujours
  questions    Json     @default("[]") // [{ id, libelle, obligatoire }]
  ouvert       Boolean  @default(true)
  creeParId    String   @map("cree_par_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  societe Societe          @relation(fields: [societeId], references: [id], onDelete: Cascade)
  poste   PosteRecrutement @relation(fields: [posteId], references: [id], onDelete: Cascade)

  @@index([societeId, ouvert])
  @@map("appels_candidature")
}

// Pièce déposée par un candidat (CV, lettre…) : data URI tant que le stockage
// objet n'est pas branché, comme les autres fichiers joints.
model PieceCandidature {
  id            String   @id @default(uuid())
  candidatureId String   @map("candidature_id")
  cle           String // cv, lettre, diplomes, portfolio, references, autre
  libelle       String
  nom           String
  url           String
  taille        Int
  createdAt     DateTime @default(now()) @map("created_at")

  candidature Candidature @relation(fields: [candidatureId], references: [id], onDelete: Cascade)

  @@index([candidatureId])
  @@map("pieces_candidature")
}

// Journal des personnalisations d'un projet (01/11/2026) : ligne ajoutée,
// modifiée ou retirée par la direction ; jamais modifié ni supprimé.
model ModificationProjet {
  id        String   @id @default(uuid())
  projetId  String   @map("projet_id")
  libelle   String // pré-rendu : « Documents du client · NINEA — ligne retirée »
  parId     String?  @map("par_id") // audit, pas de FK
  createdAt DateTime @default(now()) @map("created_at")

  projet Projet @relation(fields: [projetId], references: [id], onDelete: Cascade)

  @@index([projetId, createdAt])
  @@map("modifications_projet")
}

// Membre d'un groupe de discussion (01/11/2026).
model MembreCanal {
  canalId       String   @map("canal_id")
  utilisateurId String   @map("utilisateur_id")
  ajouteLe      DateTime @default(now()) @map("ajoute_le")

  canal       Canal       @relation(fields: [canalId], references: [id], onDelete: Cascade)
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@id([canalId, utilisateurId])
  @@index([utilisateurId])
  @@map("membres_canal")
}

// Abonnement d'un appareil aux notifications système (Web Push, 02/11/2026).
model AbonnementPush {
  id            String   @id @default(uuid())
  utilisateurId String   @map("utilisateur_id")
  endpoint      String   @unique
  p256dh        String
  auth          String
  appareil      String? // navigateur, pour s'y retrouver
  createdAt     DateTime @default(now()) @map("created_at")

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([utilisateurId])
  @@map("abonnements_push")
}

// Pièce jointe d'un message (photo, PDF…) : data URI, comme les autres fichiers joints.
model PieceMessage {
  id        String @id @default(uuid())
  messageId String @map("message_id")
  nom       String
  url       String
  taille    Int
  type      String // type MIME

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("pieces_message")
}

// Réaction à un message (une par personne et par emoji).
model ReactionMessage {
  messageId     String   @map("message_id")
  utilisateurId String   @map("utilisateur_id")
  emoji         String
  createdAt     DateTime @default(now()) @map("created_at")

  message     Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@id([messageId, utilisateurId, emoji])
  @@map("reactions_message")
}
