# Base de données (locale en dev, Hetzner en prod)
DATABASE_URL="postgresql://hub:hub@localhost:5432/hub?schema=public"

# Secret JWT — génère une vraie valeur aléatoire avant la prod
JWT_SECRET="change-moi-en-production"
JWT_EXPIRES_IN="7d"

# Port de l'API
PORT=3001

# URL du frontend (liens d'activation / reset envoyés par email)
FRONT_URL="http://localhost:3000"

# Origines autorisées à appeler l'API depuis un navigateur (CORS), séparées
# par des virgules. Défaut : FRONT_URL, sinon http://localhost:3000.
# En prod : "https://hub.group" (+ localhost si besoin pendant la transition).
CORS_ORIGINS="http://localhost:3000"

# Transport email — "log" (défaut, écrit le lien dans les logs, rien n'est
# envoyé) ou "smtp". En "smtp", SMTP_HOST doit être renseigné sinon repli "log".
EMAIL_TRANSPORT="log"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE=""          # "true" force TLS ; vide => true si port 465, sinon false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="hub360° <no-reply@greyconcrete.hub>"
MAIL_MARQUE="hub360°"

# Stockage objet (Hetzner Object Storage, S3-compatible) — à remplir plus tard
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
