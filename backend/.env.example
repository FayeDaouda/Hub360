# Toutes ces variables sont vérifiées au démarrage (src/config/environnement.ts) :
# une valeur invalide arrête l'API avec la liste des problèmes. Une variable
# vide vaut une variable absente.

# Environnement : development (défaut), test ou production. En production, la
# confiance au relais, la double authentification et le secret JWT robuste
# deviennent obligatoires.
NODE_ENV="development"

# Base de données (locale en dev, Hetzner en prod)
DATABASE_URL="postgresql://hub:hub@localhost:5432/hub?schema=public"

# Secret JWT (au moins 32 caractères aléatoires en production : openssl rand
# -base64 48). Il sert aussi à chiffrer les secrets de double authentification :
# le changer oblige chacun à réactiver son application d'authentification.
JWT_SECRET="change-moi-en-production"

# Port de l'API
PORT=3001

# URL du frontend (liens d'activation / reset envoyés par email)
FRONT_URL="http://localhost:3000"

# Origines autorisées à appeler l'API depuis un navigateur (CORS), séparées
# par des virgules. Défaut : FRONT_URL, sinon http://localhost:3000.
# En prod : "https://hub.group" (+ localhost si besoin pendant la transition).
CORS_ORIGINS="http://localhost:3000"

# Transport email — "log" (défaut, écrit le lien dans les logs, rien n'est
# envoyé) ou "smtp". En "smtp", SMTP_HOST doit être renseigné sinon repli "log".
EMAIL_TRANSPORT="log"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE=""          # "true" force TLS ; vide => true si port 465, sinon false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="hub360° <no-reply@greyconcrete.hub>"
MAIL_MARQUE="hub360°"

# Production : nombre de relais HTTP devant l'API (Caddy = 1, défaut 1), pour
# lire la vraie adresse IP du client (limitation des tentatives de connexion).
# HUB_RELAIS=1

# Double authentification : vide = règle normale (imposée en production à
# tous les comptes), "obligatoire" = partout, "desactive" = suspendue (aucun
# code demandé ; les inscriptions sont gardées pour la réactivation).
HUB_DOUBLE_FACTEUR=""

# "autorise" uniquement sur un serveur de démonstration ou de pré-production :
# permet les scripts de données de démo. Jamais sur un HUB réel.
HUB_DONNEES_DEMO=""

# Premier compte CIO d'une vraie installation (npm run demarrage uniquement).
HUB_CIO_EMAIL=""
HUB_CIO_PRENOM=""
HUB_CIO_NOM=""

# Stockage objet (Hetzner Object Storage, S3-compatible) — pas encore lu par
# l'API : les fichiers sont en base tant que le stockage objet n'est pas branché.
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
# Synchronisation de l'Agenda avec Google et Apple. Vides : désactivée.
# Clé de chiffrement des accès (générer une fois : openssl rand -base64 32 ;
# la changer rend illisibles les accès déjà enregistrés : chacun reconnecte).
AGENDA_CLE_CHIFFREMENT=""
# Application Google (console.cloud.google.com, client « Application Web »,
# URI de redirection : http://localhost:3001/api/agenda/google/retour).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
